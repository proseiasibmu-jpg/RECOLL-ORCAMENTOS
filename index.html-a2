  .recollRelSecao{
    border:1px solid #ddd;border-radius:12px;padding:13px;margin:10px 0;
    page-break-inside:avoid;
  }
  .recollRelSecao h3{margin:0 0 9px}
  .recollRelGrid{
    display:grid;grid-template-columns:1fr 1fr;gap:7px;
  }
  .recollRelItem{padding:7px;background:#fafafa;border-radius:8px}
  .recollRelItem strong{display:block;font-size:12px;color:#666}
  .recollRelFotos{
    display:grid;grid-template-columns:repeat(3,1fr);gap:8px;
  }
  .recollRelFotos img{width:100%;height:120px;object-fit:cover;border-radius:8px}
  .recollRelLista{margin:0;padding-left:20px}
  .recollRelTabela{width:100%;border-collapse:collapse}
  .recollRelTabela td,.recollRelTabela th{border-bottom:1px solid #ddd;padding:7px;text-align:left}
  .recollRelAss img{max-width:230px;max-height:100px;display:block;margin:8px 0}
  .recollRelBtns{margin-top:12px}
  .recollRelBtn{
    border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer;margin:6px 6px 0 0;
  }
  .recollRelPrimary{background:#174ea6;color:#fff}
  .recollRelSecondary{background:#eee;color:#222}
  @media(max-width:560px){
    .recollRelGrid{grid-template-columns:1fr}
    .recollRelFotos{grid-template-columns:repeat(2,1fr)}
  }
  @media print{
    body>*:not(#recollRelOverlay){display:none !important}
    #recollRelOverlay{display:block !important;position:static;background:#fff;padding:0}
    #recollRelBox{box-shadow:none;width:100%;margin:0;padding:0}
    .recollRelBtns{display:none!important}
  }
</style>
<div id="recollRelOverlay">
<div id="recollRelBox">
<div id="recollRelDocumento">
<div class="recollRelCabecalho">
<h2>RECOLL – Relatório Completo da Obra</h2>
<p id="recollRelCliente">Cliente: —</p>
<p id="recollRelObra">Obra: —</p>
<p id="recollRelData">Relatório emitido em: —</p>
</div>
<div class="recollRelSecao">
<h3>👤 Dados da obra</h3>
<div class="recollRelGrid">
<div class="recollRelItem"><strong>CLIENTE</strong><span id="relCliente">—</span></div>
<div class="recollRelItem"><strong>WHATSAPP</strong><span id="relWhats">—</span></div>
<div class="recollRelItem"><strong>CIDADE</strong><span id="relCidade">—</span></div>
<div class="recollRelItem"><strong>ENDEREÇO</strong><span id="relEndereco">—</span></div>
<div class="recollRelItem"><strong>SERVIÇO</strong><span id="relServico">—</span></div>
