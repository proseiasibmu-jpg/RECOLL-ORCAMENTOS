</style>
<div id="recollPainelOverlay">
<div id="recollPainelBox">
<h2 class="recollPainelTitulo">📊 Painel da obra</h2>
<p class="recollPainelSub">Resumo rápido da situação atual da obra.</p>
<div class="recollPainelStatus">
<strong id="recollPainelStatus">Obra</strong>
<span id="recollPainelStatusDetalhe">Resumo da obra</span>
</div>
<div class="recollPainelGrid">
<div class="recollPainelCard">
<strong>💰 VALOR CONTRATADO</strong>
<div class="recollPainelValor" id="recollPainelContratado">R$ 0,00</div>
</div>
<div class="recollPainelCard">
<strong>💵 RECEBIDO</strong>
<div class="recollPainelValor" id="recollPainelRecebido">R$ 0,00</div>
</div>
<div class="recollPainelCard">
<strong>📌 FALTA RECEBER</strong>
<div class="recollPainelValor" id="recollPainelFalta">R$ 0,00</div>
</div>
<div class="recollPainelCard">
<strong>➕ ADICIONAIS APROVADOS</strong>
<div class="recollPainelValor" id="recollPainelAdicionais">R$ 0,00</div>
</div>
<div class="recollPainelCard">
<strong>📋 PENDÊNCIAS ABERTAS</strong>
<div class="recollPainelValor" id="recollPainelPendencias">0</div>
</div>
<div class="recollPainelCard">
<strong>📅 PRAZO MAIS PRÓXIMO</strong>
<div class="recollPainelValor" id="recollPainelPrazo">—</div>
</div>
<div class="recollPainelCard" style="grid-column:1/-1">
<strong>📈 PROGRESSO DO CHECKLIST</strong>
<div class="recollPainelValor" id="recollPainelProgressoTexto">0%</div>
<div class="recollPainelBarra"><div id="recollPainelProgresso"></div></div>
</div>
</div>
<div class="recollPainelBtns">
<button class="recollPainelBtn recollPainelSecondary" onclick="recollFecharPainel()">Fechar</button>
<button class="recollPainelBtn recollPainelPrimary" onclick="recollAtualizarPainel()">🔄 Atualizar</button>
</div>
</div>
</div>
<script>
(function(){
  function moeda(v){
    return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  }
  function numeroTexto(v){
    if(v===null||v===undefined)return 0;
    let s=String(v).replace(/[^\d,.-]/g,'');
    if(s.includes(',') && s.includes('.')) s=s.replace(/\./g,'').replace(',','.');
    else if(s.includes(',')) s=s.replace(',','.');
    return Number(s)||0;
  }
  function procurar(padroes){
    const els=[...document.querySelectorAll('input,select,textarea')];
    for(const p of padroes){
      const el=els.find(e=>{
        const t=((e.id||'')+' '+(e.name||'')+' '+(e.placeholder||'')).toLowerCase();
        return t.includes(p);
      });
      if(el && String(el.value||'').trim()) return el.value;
    }
    return '';
  }
  function dataBR(v){
    if(!v)return '—';
    const p=v.split('-');
    return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:v;
  }

  window.recollAtualizarPainel=function(){
    const contratado=numeroTexto(procurar(['valor contratado','valor total','total']));
    const recebido=numeroTexto(procurar(['recebido']));
    let adicionais=0;
    try{
      const a=JSON.parse(localStorage.getItem('recoll_servicos_adicionais')||'[]');
      adicionais=a.filter(x=>x.status==='Aprovado').reduce((s,x)=>s+Number(x.total||0),0);
    }catch(e){}
    let pendAbertas=0, prazoMaisProximo='';
    try{
      const p=JSON.parse(localStorage.getItem('recoll_pendencias_obra')||'[]');
      const abertas=p.filter(x=>x.status!=='Concluída');
      pendAbertas=abertas.length;
      const datas=abertas.map(x=>x.prazo).filter(Boolean).sort();
      prazoMaisProximo=datas[0]||'';
    }catch(e){}

    let progresso=0;
    try{
      const c=JSON.parse(localStorage.getItem('recoll_checklist_obra')||'{}');
      const ch=['iniciada','material','execucao','limpeza','fotos','pendencias','cliente','termo','entregue'];
      progresso=Math.round(ch.filter(k=>c[k]).length/ch.length*100);
    }catch(e){}

    const status=procurar(['status']) || 'Obra';
    document.getElementById('recollPainelStatus').textContent=status;
    document.getElementById('recollPainelStatusDetalhe').textContent=
      pendAbertas ? pendAbertas+' pendência(s) aberta(s)' : 'Sem pendências abertas';
    document.getElementById('recollPainelContratado').textContent=moeda(contratado+adicionais);
    document.getElementById('recollPainelRecebido').textContent=moeda(recebido);
    document.getElementById('recollPainelFalta').textContent=moeda(Math.max(0,contratado+adicionais-recebido));
    document.getElementById('recollPainelAdicionais').textContent=moeda(adicionais);
    document.getElementById('recollPainelPendencias').textContent=pendAbertas;
    document.getElementById('recollPainelPrazo').textContent=dataBR(prazoMaisProximo);
    document.getElementById('recollPainelProgressoTexto').textContent=progresso+'%';
    document.getElementById('recollPainelProgresso').style.width=progresso+'%';
  };

  window.recollAbrirPainel=function(){
    recollAtualizarPainel();
    document.getElementById('recollPainelOverlay').style.display='flex';
  };
  window.recollFecharPainel=function(){
    document.getElementById('recollPainelOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    const alertas=document.getElementById('recollBtnAlertas');
    if(alertas && !document.getElementById('recollBtnPainel')){
      const b=document.createElement('button');
      b.id='recollBtnPainel';
      b.type='button';
      b.textContent='📊 Painel da obra';
      b.onclick=recollAbrirPainel;
      b.style.cssText='background:#174ea6;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      alertas.parentNode.appendChild(b);
    }
  });
})();
</script>
<style>
  #recollRelOverlay{
    display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10007;
    padding:14px;overflow:auto;align-items:flex-start;justify-content:center;
  }
  #recollRelBox{
    background:#fff;width:min(820px,100%);margin:10px auto 30px;border-radius:18px;
    padding:18px;box-shadow:0 10px 40px rgba(0,0,0,.3);
