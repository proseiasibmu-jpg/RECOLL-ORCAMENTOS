  #recollAlertOverlay{
    display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10005;
    padding:14px;overflow:auto;align-items:flex-start;justify-content:center;
  }
  #recollAlertBox{
    background:#fff;width:min(720px,100%);margin:10px auto 30px;border-radius:18px;
    padding:18px;box-shadow:0 10px 40px rgba(0,0,0,.3);
  }
  .recollAlertTitulo{margin:0 0 5px}
  .recollAlertSub{margin:0 0 15px;color:#666}
  .recollAlertCard{
    border-radius:12px;padding:13px;margin:8px 0;border-left:6px solid #888;
    background:#fafafa;
  }
  .recollAlertCard.verde{border-left-color:#16803a}
  .recollAlertCard.amarelo{border-left-color:#c58a00}
  .recollAlertCard.vermelho{border-left-color:#c62828}
  .recollAlertCard strong{display:block}
  .recollAlertCard small{color:#666}
  .recollAlertBadge{
    display:inline-block;padding:5px 9px;border-radius:15px;font-weight:800;font-size:12px;
    margin-top:7px;background:#eee;
  }
  .recollAlertBtns{margin-top:10px}
  .recollAlertBtn{
    border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer;margin:6px 6px 0 0;
  }
  .recollAlertPrimary{background:#174ea6;color:#fff}
  .recollAlertSecondary{background:#eee;color:#222}
  .recollAlertVazio{
    padding:16px;border:1px solid #ddd;border-radius:12px;background:#fafafa;
  }
</style>
<div id="recollAlertOverlay">
<div id="recollAlertBox">
<h2 class="recollAlertTitulo">🔔 Alertas de prazo</h2>
<p class="recollAlertSub">Veja rapidamente o que está no prazo, próximo do vencimento ou atrasado.</p>
<div id="recollAlertLista"></div>
<div class="recollAlertBtns">
<button class="recollAlertBtn recollAlertSecondary" onclick="recollFecharAlertas()">Fechar</button>
<button class="recollAlertBtn recollAlertPrimary" onclick="recollAtualizarAlertas()">🔄 Atualizar</button>
</div>
</div>
</div>
<script>
(function(){
  function parseData(v){
    if(!v)return null;
    const p=v.split('-');
    if(p.length===3)return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]));
    return null;
  }
  function inicioHoje(){
    const d=new Date();
    return new Date(d.getFullYear(),d.getMonth(),d.getDate());
  }
  function diasAte(data){
    const hoje=inicioHoje();
    return Math.ceil((data-hoje)/86400000);
  }
  function classificar(dias){
    if(dias<0)return {classe:'vermelho',texto:'🔴 Prazo vencido'};
    if(dias<=3)return {classe:'amarelo',texto:'🟡 Prazo próximo'};
    return {classe:'verde',texto:'🟢 No prazo'};
  }
  function formatarData(v){
    if(!v)return '—';
    const p=v.split('-');
    return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:v;
  }

  window.recollAtualizarAlertas=function(){
    const lista=document.getElementById('recollAlertLista');
    const itens=[];

    // Pendências cadastradas nesta obra.
    try{
      const ps=JSON.parse(localStorage.getItem('recoll_pendencias_obra')||'[]');
      ps.forEach((p,i)=>{
        if(p.status==='Concluída'||!p.prazo)return;
        const data=parseData(p.prazo);
        if(!data)return;
        const dias=diasAte(data), c=classificar(dias);
        itens.push({
          data,classe:c.classe,texto:c.texto,
          titulo:'Pendência: '+p.descricao,
          detalhe:'Prazo: '+formatarData(p.prazo)+' · Responsável: '+(p.responsavel||'—'),
          ordem:data.getTime()
        });
      });
    }catch(e){}

    itens.sort((a,b)=>a.ordem-b.ordem);
    lista.innerHTML='';

    if(!itens.length){
      lista.innerHTML='<div class="recollAlertVazio">🎉 Nenhum prazo de pendência precisa de atenção no momento.</div>';
      return;
    }

    itens.forEach(x=>{
      const div=document.createElement('div');
      div.className='recollAlertCard '+x.classe;
      div.innerHTML='<strong>'+x.titulo+'</strong>'+
        '<small>'+x.detalhe+'</small><br>'+
        '<span class="recollAlertBadge">'+x.texto+'</span>';
      lista.appendChild(div);
    });
  };

  window.recollAbrirAlertas=function(){
    recollAtualizarAlertas();
    document.getElementById('recollAlertOverlay').style.display='flex';
  };
  window.recollFecharAlertas=function(){
    document.getElementById('recollAlertOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    const pend=document.getElementById('recollBtnPendencias');
    if(pend && !document.getElementById('recollBtnAlertas')){
      const b=document.createElement('button');
      b.id='recollBtnAlertas';
      b.type='button';
      b.textContent='🔔 Alertas de prazo';
      b.onclick=recollAbrirAlertas;
      b.style.cssText='background:#8b5a00;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      pend.parentNode.appendChild(b);
    }
  });
})();
</script>
