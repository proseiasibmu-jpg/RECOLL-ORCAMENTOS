<div id="recollChecklistOverlay">
<div id="recollChecklistBox">
<h2 class="recollCheckTitulo">📋 Checklist da obra</h2>
<p class="recollCheckSub">Marque as etapas concluídas para acompanhar a obra.</p>
<div class="recollCheckLista">
<label class="recollCheckItem"><input data-check="iniciada" type="checkbox"/> Obra iniciada</label>
<label class="recollCheckItem"><input data-check="material" type="checkbox"/> Material conferido</label>
<label class="recollCheckItem"><input data-check="execucao" type="checkbox"/> Execução concluída</label>
<label class="recollCheckItem"><input data-check="limpeza" type="checkbox"/> Limpeza realizada</label>
<label class="recollCheckItem"><input data-check="fotos" type="checkbox"/> Fotos finais registradas</label>
<label class="recollCheckItem"><input data-check="pendencias" type="checkbox"/> Pendências verificadas</label>
<label class="recollCheckItem"><input data-check="cliente" type="checkbox"/> Cliente vistoriou a obra</label>
<label class="recollCheckItem"><input data-check="termo" type="checkbox"/> Termo assinado</label>
<label class="recollCheckItem"><input data-check="entregue" type="checkbox"/> Obra entregue</label>
</div>
<div class="recollCheckProgresso">
<strong id="recollCheckTexto">0 de 9 etapas concluídas</strong>
<div class="recollCheckBarra"><div id="recollCheckBarraInterna"></div></div>
</div>
<div class="recollCheckStatus" id="recollCheckStatus"></div>
<div class="recollCheckBtns">
<button class="recollCheckBtn recollCheckSecondary" onclick="recollFecharChecklist()">Fechar</button>
<button class="recollCheckBtn recollCheckPrimary" onclick="recollSalvarChecklist()">💾 Salvar checklist</button>
</div>
</div>
</div>
<script>
(function(){
  const chave='recoll_checklist_obra';
  const caixas=()=>[...document.querySelectorAll('#recollChecklistBox input[data-check]')];

  function atualizar(){
    const lista=caixas();
    const feitos=lista.filter(c=>c.checked).length;
    document.getElementById('recollCheckTexto').textContent=feitos+' de '+lista.length+' etapas concluídas';
    document.getElementById('recollCheckBarraInterna').style.width=(feitos/lista.length*100)+'%';
  }

  function carregar(){
    try{
      const salvo=JSON.parse(localStorage.getItem(chave)||'{}');
      caixas().forEach(c=>c.checked=!!salvo[c.dataset.check]);
    }catch(e){}
    atualizar();
  }

  window.recollSalvarChecklist=function(){
    const dados={};
    caixas().forEach(c=>dados[c.dataset.check]=c.checked);
    localStorage.setItem(chave,JSON.stringify(dados));
    document.getElementById('recollCheckStatus').textContent='Checklist salvo nesta obra.';
    atualizar();
  };

  window.recollAbrirChecklist=function(){
    carregar();
    document.getElementById('recollChecklistOverlay').style.display='flex';
  };

  window.recollFecharChecklist=function(){
    document.getElementById('recollChecklistOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    caixas().forEach(c=>c.addEventListener('change',atualizar));

    const adicionais=document.getElementById('recollBtnAdicionais');
    if(adicionais && !document.getElementById('recollBtnChecklist')){
      const b=document.createElement('button');
      b.id='recollBtnChecklist';
      b.type='button';
      b.textContent='📋 Checklist da obra';
      b.onclick=recollAbrirChecklist;
      b.style.cssText='background:#6b3fa0;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      adicionais.parentNode.appendChild(b);
    }
  });
})();
</script>
