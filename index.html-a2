<div id="recollFotosOverlay">
<div id="recollFotosBox">
<h2 class="recollFotosTitulo">📸 Fotos da obra</h2>
<p class="recollFotosSub">Organize o histórico visual da obra em Antes, Durante e Depois.</p>
<div class="recollFotosGrupo">
<h3>🔴 Antes</h3>
<input accept="image/*" class="recollFotosInput" id="recollFotosAntesInput" multiple="" onchange="recollAdicionarFotos('antes',this)" type="file"/>
<div class="recollFotosGrid" id="recollFotosAntesGrid"></div>
</div>
<div class="recollFotosGrupo">
<h3>🟠 Durante</h3>
<input accept="image/*" class="recollFotosInput" id="recollFotosDuranteInput" multiple="" onchange="recollAdicionarFotos('durante',this)" type="file"/>
<div class="recollFotosGrid" id="recollFotosDuranteGrid"></div>
</div>
<div class="recollFotosGrupo">
<h3>🟢 Depois</h3>
<input accept="image/*" class="recollFotosInput" id="recollFotosDepoisInput" multiple="" onchange="recollAdicionarFotos('depois',this)" type="file"/>
<div class="recollFotosGrid" id="recollFotosDepoisGrid"></div>
</div>
<div class="recollFotoStatus" id="recollFotosStatus"></div>
<div class="recollFotosBtns">
<button class="recollFotoBtn recollFotoSecondary" onclick="recollFecharFotosObra()">Fechar</button>
<button class="recollFotoBtn recollFotoPrimary" onclick="recollSalvarFotosObra()">💾 Salvar fotos</button>
</div>
</div>
</div>
<script>
(function(){
  const chave='recoll_fotos_obra';
  let fotos={antes:[],durante:[],depois:[]};

  function carregar(){
    try{
      const salvo=localStorage.getItem(chave);
      if(salvo) fotos=Object.assign(fotos,JSON.parse(salvo));
    }catch(e){}
  }

  function renderGrupo(tipo){
    const grid=document.getElementById('recollFotos'+tipo.charAt(0).toUpperCase()+tipo.slice(1)+'Grid');
    if(!grid)return;
    grid.innerHTML='';
    fotos[tipo].forEach((src,i)=>{
      const item=document.createElement('div');
      item.className='recollFotoItem';
      item.innerHTML='<img src="'+src+'" alt="Foto '+tipo+'"><button class="recollFotoExcluir" type="button" onclick="recollExcluirFoto(\''+tipo+'\','+i+')">×</button>';
      grid.appendChild(item);
    });
  }

  function renderTudo(){
    ['antes','durante','depois'].forEach(renderGrupo);
  }

  window.recollAdicionarFotos=function(tipo,input){
    const arquivos=[...(input.files||[])];
    arquivos.forEach(arquivo=>{
      if(!arquivo.type.startsWith('image/')) return;
      const leitor=new FileReader();
      leitor.onload=function(e){
        fotos[tipo].push(e.target.result);
        renderGrupo(tipo);
      };
      leitor.readAsDataURL(arquivo);
    });
    input.value='';
  };

  window.recollExcluirFoto=function(tipo,i){
    fotos[tipo].splice(i,1);
    renderGrupo(tipo);
  };

  window.recollSalvarFotosObra=function(){
    try{
      localStorage.setItem(chave,JSON.stringify(fotos));
      const s=document.getElementById('recollFotosStatus');
      if(s)s.textContent='Fotos salvas nesta obra.';
    }catch(e){
      const s=document.getElementById('recollFotosStatus');
      if(s)s.textContent='Não foi possível salvar todas as fotos. Tente menos fotos por vez.';
    }
  };

  window.recollAbrirFotosObra=function(){
    carregar();
    renderTudo();
    const o=document.getElementById('recollFotosOverlay');
    if(o)o.style.display='flex';
  };

  window.recollFecharFotosObra=function(){
    const o=document.getElementById('recollFotosOverlay');
    if(o)o.style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    carregar();

    const ficha=document.getElementById('recollBtnFichaObraReal');
    if(ficha && !document.getElementById('recollBtnFotosObra')){
      const b=document.createElement('button');
      b.id='recollBtnFotosObra';
      b.type='button';
      b.textContent='📸 Fotos da obra';
      b.onclick=recollAbrirFotosObra;
      b.style.cssText='background:#16803a;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      ficha.parentNode.appendChild(b);
    }
  });
})();
</script>
