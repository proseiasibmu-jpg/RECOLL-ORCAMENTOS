    border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer;margin:6px 6px 0 0;
  }
  .recollAdPrimary{background:#174ea6;color:#fff}
  .recollAdSecondary{background:#eee;color:#222}
  .recollAdStatus{font-size:13px;color:#16733a;min-height:18px;margin-top:8px}
  @media(max-width:600px){
    .recollAdForm{grid-template-columns:1fr 1fr}
    .recollAdForm .recollAdFull,.recollAdForm label:first-child{grid-column:1/-1}
    .recollAdResumo{grid-template-columns:1fr}
  }
</style>
<div id="recollAdicionalOverlay">
<div id="recollAdicionalBox">
<h2 class="recollAdTitulo">➕ Serviços adicionais</h2>
<p class="recollAdSub">Registre tudo que foi solicitado além do orçamento original.</p>
<div class="recollAdForm">
<label class="recollAdFull">Descrição do serviço
        <input id="recollAdDescricao" placeholder="Ex.: Pintura de um quarto adicional" type="text"/>
</label>
<label>Quantidade
        <input id="recollAdQtd" min="0" step="0.01" type="number" value="1"/>
</label>
<label>Unidade
        <select id="recollAdUnidade">
<option>un.</option><option>m²</option><option>m</option><option>hora</option><option>dia</option><option>serviço</option>
</select>
</label>
<label>Valor
        <input id="recollAdValor" min="0" placeholder="0,00" step="0.01" type="number"/>
</label>
<label class="recollAdFull">Data
        <input id="recollAdData" type="date"/>
</label>
<label class="recollAdFull">Observação
        <textarea id="recollAdObs" placeholder="Detalhes ou combinação com o cliente" rows="2"></textarea>
</label>
</div>
<div class="recollAdBtns">
<button class="recollAdBtn recollAdPrimary" onclick="recollAdicionarServico()">➕ Adicionar serviço</button>
</div>
<div class="recollAdResumo">
<div class="recollAdCard"><strong>ORIGINAL</strong><span id="recollAdOriginal">R$ 0,00</span></div>
<div class="recollAdCard"><strong>ADICIONAIS APROVADOS</strong><span id="recollAdTotal">R$ 0,00</span></div>
<div class="recollAdCard"><strong>NOVO TOTAL</strong><span id="recollAdNovoTotal">R$ 0,00</span></div>
</div>
<div class="recollAdLista" id="recollAdLista"></div>
<div class="recollAdStatus" id="recollAdStatus"></div>
<button class="recollAdBtn recollAdSecondary" onclick="recollFecharAdicionais()">Fechar</button>
<button class="recollAdBtn recollAdPrimary" onclick="recollSalvarAdicionais()">💾 Salvar adicionais</button>
</div>
</div>
<script>
(function(){
  const chave='recoll_servicos_adicionais';
  let adicionais=[];

  function moeda(v){
    return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  }
  function carregar(){
    try{
      const salvo=localStorage.getItem(chave);
      adicionais=salvo?JSON.parse(salvo):[];
    }catch(e){adicionais=[];}
  }
  function original(){
    const els=[...document.querySelectorAll('input,select,textarea')];
    const el=els.find(e=>{
      const t=((e.id||'')+' '+(e.name||'')+' '+(e.placeholder||'')).toLowerCase();
      return /valor total|valor contratado|total/.test(t);
    });
    return el ? Number(String(el.value).replace(/\./g,'').replace(',','.').replace(/[^\d.-]/g,''))||0 : 0;
  }
  function render(){
    const orig=original();
    const aprovados=adicionais.filter(x=>x.status==='Aprovado').reduce((s,x)=>s+x.total,0);
    document.getElementById('recollAdOriginal').textContent=moeda(orig);
    document.getElementById('recollAdTotal').textContent=moeda(aprovados);
    document.getElementById('recollAdNovoTotal').textContent=moeda(orig+aprovados);

    const lista=document.getElementById('recollAdLista');
    lista.innerHTML='';
    if(!adicionais.length){
      lista.innerHTML='<div class="recollAdItem">Nenhum serviço adicional cadastrado.</div>';
      return;
    }
    adicionais.forEach((x,i)=>{
      const div=document.createElement('div');
      div.className='recollAdItem';
      div.innerHTML=
        '<strong>'+x.descricao+'</strong>'+
        '<small>'+x.qtd+' '+x.unidade+' × '+moeda(x.valor)+' = <b>'+moeda(x.total)+'</b><br>'+
        'Data: '+(x.data||'—')+' · Status: <b>'+x.status+'</b>'+
        (x.obs?'<br>Obs.: '+x.obs:'')+'</small>'+
        '<div class="recollAdAcoes">'+
        (x.status!=='Aprovado'?'<button class="recollAdAprovar" onclick="recollAprovarAdicional('+i+')">✅ Aprovar</button>':'')+
        '<button class="recollAdExcluir" onclick="recollExcluirAdicional('+i+')">Excluir</button></div>';
      lista.appendChild(div);
    });
  }

  window.recollAdicionarServico=function(){
    const descricao=document.getElementById('recollAdDescricao').value.trim();
    const qtd=Number(document.getElementById('recollAdQtd').value)||0;
    const unidade=document.getElementById('recollAdUnidade').value;
    const valor=Number(document.getElementById('recollAdValor').value)||0;
    const data=document.getElementById('recollAdData').value;
    const obs=document.getElementById('recollAdObs').value.trim();
    if(!descricao||qtd<=0||valor<0){
      document.getElementById('recollAdStatus').textContent='Preencha a descrição, quantidade e valor.';
      return;
    }
    adicionais.push({descricao,qtd,unidade,valor,total:qtd*valor,data,obs,status:'Aguardando aprovação'});
    ['recollAdDescricao','recollAdData','recollAdObs','recollAdValor'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('recollAdQtd').value='1';
    document.getElementById('recollAdStatus').textContent='Serviço adicional cadastrado.';
    render();
  };
  window.recollAprovarAdicional=function(i){
    adicionais[i].status='Aprovado';
    render();
  };
  window.recollExcluirAdicional=function(i){
    adicionais.splice(i,1);
    render();
  };
  window.recollSalvarAdicionais=function(){
    localStorage.setItem(chave,JSON.stringify(adicionais));
    document.getElementById('recollAdStatus').textContent='Serviços adicionais salvos nesta obra.';
  };
  window.recollAbrirAdicionais=function(){
    carregar(); render();
    document.getElementById('recollAdicionalOverlay').style.display='flex';
  };
  window.recollFecharAdicionais=function(){
    document.getElementById('recollAdicionalOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    const fotos=document.getElementById('recollBtnFotosObra');
    if(fotos && !document.getElementById('recollBtnAdicionais')){
      const b=document.createElement('button');
      b.id='recollBtnAdicionais';
      b.type='button';
      b.textContent='➕ Serviços adicionais';
      b.onclick=recollAbrirAdicionais;
      b.style.cssText='background:#b35a00;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      fotos.parentNode.appendChild(b);
    }
  });
})();
</script>
