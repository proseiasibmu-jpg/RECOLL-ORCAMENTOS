<tr><th>Adicionais aprovados</th><td id="relAdicionais">R$ 0,00</td></tr>
<tr><th>Total atualizado</th><td id="relTotal">R$ 0,00</td></tr>
<tr><th>Recebido</th><td id="relRecebido">R$ 0,00</td></tr>
<tr><th>Saldo a receber</th><td id="relSaldo">R$ 0,00</td></tr>
</table>
</div>
