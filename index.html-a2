  .recollPendForm{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .recollPendForm label{font-size:13px;font-weight:700}
  .recollPendForm input,.recollPendForm select,.recollPendForm textarea{
    width:100%;box-sizing:border-box;margin-top:5px;padding:10px;border:1px solid #ccc;
    border-radius:9px;background:#fff;
