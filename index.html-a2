<!DOCTYPE html>

<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>RECOLL — Orçamento Inteligente v10</title>
<style>
*{box-sizing:border-box}body{font-family:Arial,sans-serif;margin:0;background:#f3f6fb;color:#172033}
header{background:#1457d9;color:white;padding:15px 16px;display:flex;align-items:center;gap:12px}
.logoBox{width:52px;height:52px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:none}
.logoBox img{width:100%;height:100%;object-fit:contain;padding:5px}.logoText{font-weight:900;color:#1457d9;font-size:22px}
h1{font-size:20px;margin:0}.sub{font-size:12px;opacity:.9}
main{max-width:760px;margin:auto;padding:16px}.card{background:white;border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 2px 12px #00000010}
button{border:0;border-radius:11px;padding:12px 14px;font-weight:700;cursor:pointer;margin:4px 3px 4px 0}
.primary{background:#1457d9;color:#fff}.green{background:#159447;color:#fff}.gray{background:#e8edf5;color:#172033}.danger{background:#fee;color:#a22}
input,select,textarea{width:100%;padding:11px;border:1px solid #ccd5e3;border-radius:10px;margin:5px 0 9px;font-size:15px}
label{font-size:13px;font-weight:700}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.hidden{display:none}
.total{font-size:25px;font-weight:900;color:#1457d9}.small{font-size:12px;color:#657085}
.item{border:1px solid #dbe2ed;border-radius:12px;padding:12px;margin:9px 0;background:#fbfcfe}
.itemHead{display:flex;justify-content:space-between;gap:8px;align-items:center}.itemHead b{font-size:14px}
.money{font-weight:800}.tag{display:inline-block;background:#eaf1ff;color:#1457d9;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:700}
.quote{background:#fff;padding:28px;max-width:850px;margin:auto}.qhead{display:flex;justify-content:space-between;gap:20px;border-bottom:2px solid #1457d9;padding-bottom:14px}
.qlogo{width:70px;height:70px;border-radius:10px;object-fit:contain;border:1px solid #ddd;padding:4px}table{width:100%;border-collapse:collapse;margin-top:18px}
th,td{padding:9px;border-bottom:1px solid #ddd;text-align:left}th:last-child,td:last-child{text-align:right}
@media(max-width:520px){.row{grid-template-columns:1fr}.qhead{flex-direction:column}main{padding:10px}}

<style>
.sinapi-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.sinapi-cat{border:1px solid #d5dbea;background:#f8faff;border-radius:12px;padding:11px;text-align:left;font-weight:600;cursor:pointer}
.sinapi-cat.selected{border:2px solid #1769e0;background:#eaf2ff}
.sinapi-service{display:flex;gap:10px;align-items:flex-start;border:1px solid #d9deea;border-radius:12px;padding:10px;margin:7px 0;background:#fff}
.sinapi-service input{width:auto;margin-top:4px}
.sinapi-service .ref{font-size:12px;color:#667085;margin-top:3px}
.sinapi-qty{width:100%;margin-top:6px}
.sinapi-empty{padding:10px;background:#fff8e8;border-radius:10px;color:#6b5b00}

.sinapi-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.sinapi-cat{border:1px solid #d3dbea;background:#fff;border-radius:12px;padding:12px 10px;text-align:left;font-weight:700;font-size:14px;min-height:52px}.sinapi-cat.selected{background:#e7f0ff;border-color:#1457d9;color:#123c91}.sinapi-service-category{margin-top:14px}.sinapi-service-title{font-size:17px;font-weight:800;margin-bottom:8px}.sinapi-service-grid{display:grid;grid-template-columns:1fr;gap:8px}.sinapi-service-btn{width:100%;display:flex;align-items:center;gap:10px;text-align:left;border:1px solid #d5dbe6;background:#fff;border-radius:12px;padding:12px;cursor:pointer}.sinapi-service-btn.selected{background:#e9f8ef;border-color:#16803a}.sinapi-service-btn .check{font-size:20px;font-weight:900;min-width:22px}.sinapi-service-btn small{display:block;color:#687386;margin-top:3px}.sinapi-service-btn b{font-size:15px}.sinapi-empty{padding:10px;border-radius:10px;background:#fff3cd;border:1px solid #ffe69c}.sinapi-qty{margin-top:6px}
@media(max-width:520px){.sinapi-grid{grid-template-columns:1fr}}
</style>
</style>
<style>
.homeScreen{background:transparent;padding:2px 0}
.welcome{background:#fff;border-radius:18px;padding:14px;margin:8px 0 12px;display:flex;align-items:center;gap:12px;box-shadow:0 2px 12px #0001}
.welcomeLogo{width:72px;height:72px;border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:none;border:1px solid #e4e8ef}
.welcomeLogo img{width:100%;height:100%;object-fit:contain;padding:5px}.homeR{font-size:38px;font-weight:900;color:#1457d9}
.welcomeText h2{margin:0;color:#1457d9;font-size:27px}.welcomeText div{font-size:12px;font-weight:800;color:#233a65;margin:2px 0 6px}.welcomeText b{font-size:11px;color:#2c7a1f}
.menuGrid{display:flex;flex-direction:column;gap:10px}
.bigBtn{width:100%;min-height:78px;border-radius:16px;border:0;padding:12px 14px;display:grid;grid-template-columns:52px 1fr 22px;align-items:center;text-align:left;box-shadow:0 3px 10px #0002;color:#fff}
.bigBtn .ico{font-size:31px;text-align:center}.bigBtn strong{display:block;font-size:18px;line-height:1.05}.bigBtn small{display:block;font-size:12px;margin-top:5px;opacity:.95;font-weight:500}.bigBtn>b{font-size:32px;text-align:right;font-weight:400}
.blue{background:#1457d9}.green{background:#20a842}.orange{background:#f47b20}.yellow{background:#f4c51c;color:#172033}.lightblue{background:#3197e5}.purple{background:#6042b5}.red{background:#db332c}.grayBtn{background:#65707b}
.slogan{text-align:center;color:#1457d9;font-size:18px;font-style:italic;padding:16px 5px 4px;font-family:cursive}
@media(max-width:430px){.welcomeText h2{font-size:23px}.bigBtn{min-height:76px}.bigBtn strong{font-size:16px}.bigBtn small{font-size:11px}}
</style></head>
<body>
<header>
<div class="logoBox" id="headLogo"><span class="logoText">R</span></div>
<div><h1>RECOLL — Orçamento Inteligente</h1><div class="sub">RECOLL v38 • orçamento, contrato, vistoria e manutenção</div></div>
</header>
<main>
<div class="homeScreen" id="home">
<style>
#home{
 width:100%!important;max-width:none!important;box-sizing:border-box!important;
 padding:12px 14px 26px!important;margin:0!important;background:#f5f8fc!important;
 overflow:visible!important
}
#r39Head{
 position:relative;background:#fff;border-radius:20px;min-height:126px;
 padding:12px 70px 10px 12px;box-sizing:border-box;margin:0 0 12px;
 display:flex;align-items:center;box-shadow:0 4px 16px rgba(20,40,80,.10)
}
#r39Logo{
 width:92px;height:92px;flex:0 0 92px;display:flex;align-items:center;justify-content:center
}
#r39LogoMark{
 font-size:44px;font-weight:900;letter-spacing:-3px;color:#123c91;line-height:1
}
#r39LogoMark em{font-style:normal;color:#19a04a}
#r39Brand{min-width:0}
#r39Brand h1{margin:0;color:#123c91;font-size:31px;line-height:1;font-weight:900}
#r39Brand .line{font-size:10.5px;color:#193568;font-weight:800;margin-top:5px}
#r39Brand .slogan{font-size:17px;color:#168d43;font-weight:700;font-style:italic;margin-top:7px}
#r39Menu{
 position:absolute;right:10px;top:10px;width:58px;height:58px;border:0;border-radius:15px;
 background:#1457d9;color:#fff;font-size:28px;font-weight:800;box-shadow:0 4px 12px #0003;z-index:30
}
#r39Models{
 width:100%;min-height:78px;margin:0 0 14px;padding:11px 16px;box-sizing:border-box;
 border:0;border-radius:18px;background:linear-gradient(135deg,#075bea,#1454aa);
 color:#fff;display:flex;align-items:center;gap:14px;box-shadow:0 5px 14px #0002
}
#r39Models .ico{font-size:31px;flex:0 0 auto}
#r39Models .txt{flex:1;text-align:left;font-size:20px;font-weight:800}
#r39Models .arr{font-size:34px}
#r39Grid{
 display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
 gap:12px!important;width:100%!important;margin:0!important
}
#r39Grid .r39card{
 min-width:0!important;width:100%!important;min-height:124px!important;
 margin:0!important;padding:13px!important;box-sizing:border-box!important;
 border:0!important;border-radius:19px!important;display:flex!important;
 align-items:center!important;gap:8px!important;overflow:hidden!important;
 box-shadow:0 5px 14px #0002!important
}
#r39Grid .r39card .ci{flex:0 0 58px;font-size:38px;text-align:center}
#r39Grid .r39card .ct{flex:1;min-width:0;text-align:left}
#r39Grid .r39card strong{display:block;font-size:17px;line-height:1.05}
#r39Grid .r39card small{display:block;font-size:11.5px;line-height:1.22;margin-top:7px}
#r39Grid .r39card .ca{flex:0 0 20px;font-size:31px}
.r39blue{background:linear-gradient(135deg,#075bea,#1769d8);color:#fff}
.r39green{background:linear-gradient(135deg,#0eab4f,#19b85b);color:#fff}
.r39orange{background:linear-gradient(135deg,#ff6b00,#ff851b);color:#fff}
.r39purple{background:linear-gradient(135deg,#6230c8,#7443d7);color:#fff}
.r39yellow{background:linear-gradient(135deg,#f5c400,#ffd21a);color:#172033}
.r39cyan{background:linear-gradient(135deg,#079dcb,#16acd8);color:#fff}
#r39Highlights{
 margin:16px 0 0;background:#fff;border-radius:17px;padding:11px 5px;
 display:grid;grid-template-columns:repeat(3,1fr);box-shadow:0 3px 12px #0001
}
#r39Highlights div{text-align:center;padding:3px 7px;border-right:1px solid #dce3ec;font-size:10px;font-weight:800;color:#17366f;line-height:1.25}
#r39Highlights div:last-child{border-right:0}
#r39Highlights b{display:block;font-size:23px;margin-bottom:4px}
#r39Bottom{
 text-align:center;margin:17px 0 0;padding:7px 8px 0;color:#123c91;font-size:23px;
 font-weight:700;font-style:italic
}
#r39Bottom span{display:block;color:#238b45;font-size:11px;font-style:normal;font-weight:800;margin-top:6px}
#r39MenuPanel{
 display:none;position:absolute;right:10px;top:75px;width:min(330px,calc(100vw - 42px));
 max-height:calc(100vh - 90px);overflow:auto;background:#fff;border-radius:16px;padding:12px;
 box-shadow:0 10px 30px #0003;z-index:100
}
#r39MenuPanel.open{display:block}
#r39MenuPanel h3{margin:2px 4px 10px;color:#1457d9}
#r39MenuPanel button{width:100%;border:0;border-radius:10px;background:#f0f3f7;padding:12px;margin:5px 0;text-align:left;font-weight:700}
#r39Shade{display:none;position:fixed;inset:0;background:#0002;z-index:90}
#r39Shade.open{display:block}
@media(max-width:430px){
 #home{padding:9px 10px 22px!important}
 #r39Head{min-height:108px;padding-right:66px}
 #r39Logo{width:66px;height:66px;flex-basis:66px}
 #r39LogoMark{font-size:34px}
 #r39Brand h1{font-size:27px}
 #r39Brand .line{font-size:8.5px}
 #r39Brand .slogan{font-size:13px}
 #r39Menu{width:52px;height:52px;font-size:25px}
 #r39Models{min-height:66px;padding:9px 12px}
 #r39Models .txt{font-size:16px}
 #r39Grid{gap:10px!important}
 #r39Grid .r39card{min-height:108px!important;padding:10px!important}
 #r39Grid .r39card .ci{flex-basis:40px;font-size:29px}
 #r39Grid .r39card strong{font-size:14px}
 #r39Grid .r39card small{font-size:10px;margin-top:5px}
 #r39Grid .r39card .ca{font-size:26px}
 #r39Highlights div{font-size:8px;padding:2px 4px}
 #r39Highlights b{font-size:17px}
 #r39Bottom{font-size:18px}
}
</style>
<div id="r39Head">
<div id="r39Logo"><img alt="Logo RECOLL" src="data:image/png;base64,"/></div>
<div id="r39Brand">
<h1>RECOLL</h1>
<div class="line">REFORMA • CONSTRUÇÃO • LIMPEZA PÓS-OBRA</div>
<div class="slogan">Ambientes limpos. Novos começos.</div>
</div>
<button id="r39Menu" type="button">☰</button>
<div id="r39Shade"></div>
<div id="r39MenuPanel">
<h3>RECOLL — Menu</h3>
<button data-r39="👥 Central de Clientes">👥 Clientes</button>
<button data-r39="💰 Tabela de Preços">💰 Tabela de Preços</button>
<button data-r39="📊 Financeiro">📊 Financeiro</button>
<button data-r39="📅 Agenda da RECOLL">📅 Agenda</button>
<button data-r39="📋 Pendências da obra">📋 Pendências</button>
<button data-r39="🔔 Alertas de prazo">🔔 Alertas</button>
<button data-r39="📊 Painel da obra">📊 Painel</button>
<button data-r39="📄 Relatório completo">📄 Relatório</button>
<button data-r39="📸 Fotos da obra">📸 Fotos</button>
<button data-r39="📋 Checklist da obra">📋 Checklist</button>
<button data-r39="🏁 Entrega da obra">🏁 Entrega</button>
<button data-r39="⚙️ Configurações">⚙️ Configurações</button>
</div>
</div>
<button id="r39Models" type="button">
<span class="ico">📝</span><span class="txt">Modelos de Orçamento</span><span class="arr">›</span>
</button>
<div id="r39Grid">
<button class="r39card r39blue" onclick="recollOpenVistorias()" type="button"><span class="ci">📸</span><span class="ct"><strong>VISTORIA</strong><small>Vistorias salvas</small></span><b class="ca">›</b></button>
<button class="r39card r39green" onclick="recollOpenOrcamentos()" type="button"><span class="ci">📝</span><span class="ct"><strong>ORÇAMENTO</strong><small>Orçamentos salvos</small></span><b class="ca">›</b></button>
<button class="r39card r39orange" onclick="show('maintenance')" type="button"><span class="ci">🔧</span><span class="ct"><strong>MANUTENÇÃO</strong><small>Serviços e manutenções</small></span><b class="ca">›</b></button>
<button class="r39card r39purple" onclick="(currentQuote ? openContractFromQuote() : recollOpenOrcamentos())" type="button"><span class="ci">📑</span><span class="ct"><strong>CONTRATOS</strong><small>Contratos a partir do orçamento</small></span><b class="ca">›</b></button>
<button class="r39card r39yellow" onclick="show('works')" type="button"><span class="ci">📂</span><span class="ct"><strong>MINHAS OBRAS</strong><small>Acompanhe suas obras</small></span><b class="ca">›</b></button>
<button class="r39card r39cyan" onclick="recollAbrirFichaObra()" type="button"><span class="ci">📋</span><span class="ct"><strong>FICHA DA OBRA</strong><small>Detalhes e acompanhamento</small></span><b class="ca">›</b></button>
</div>
<div id="r39Highlights">
<div><b>✓</b>QUALIDADE<br/>EM CADA DETALHE</div>
<div><b>👥</b>PARA O SEU PROJETO,<br/>SEMPRE A MELHOR SOLUÇÃO</div>
<div><b>🌿</b>MAIS QUE LIMPEZA,<br/>REALIZAMOS ENTREGAS</div>
</div>
<div id="r39Bottom">Mais que limpeza, realizamos entregas.<span>RECOLL • QUALIDADE EM CADA DETALHE</span></div>
<script>
(function(){
 function closeMenu(){
  document.getElementById('r39MenuPanel').classList.remove('open');
  document.getElementById('r39Shade').classList.remove('open');
 }
 function openMenu(){
  document.getElementById('r39MenuPanel').classList.add('open');
  document.getElementById('r39Shade').classList.add('open');
 }
 function target(label){
  closeMenu();
  var b=[...document.querySelectorAll('button,a')].find(function(el){
   if(el.id && el.id.indexOf('r39')===0)return false;
   return (el.textContent||'').replace(/\s+/g,' ').trim().indexOf(label)>=0;
  });
  if(b)b.click();
 }
 document.getElementById('r39Models').onclick=function(){
  if(window.recollAbrirModelos)window.recollAbrirModelos();
 };
 document.getElementById('r39Menu').onclick=function(){
  var p=document.getElementById('r39MenuPanel');
  p.classList.contains('open')?closeMenu():openMenu();
 };
 document.getElementById('r39Shade').onclick=closeMenu;
 document.querySelectorAll('#r39MenuPanel [data-r39]').forEach(function(b){
  b.onclick=function(){target(b.getAttribute('data-r39'));};
 });
})();
</script>
</div>
<div class="card hidden" id="new">
<h2>Novo Orçamento</h2>
<label>Cliente</label><input id="client" placeholder="Nome do cliente"/>
<label>WhatsApp</label><input id="phone" inputmode="tel" placeholder="(11) 99999-9999"/>
<div class="row"><div><label>Cidade</label><select id="city"><option>São Bernardo do Campo</option><option>Santo André</option><option>São Caetano do Sul</option><option>Diadema</option><option>Mauá</option><option>Ribeirão Pires</option><option>Rio Grande da Serra</option><option>Outra cidade</option></select></div>
<div><label>Tipo</label><select id="kind"><option>Particular</option><option>Construtora</option><option>Condomínio</option></select></div></div>
<label>Endereço da obra</label><input id="address" placeholder="Rua, número, bairro"/>
<div class="card" style="padding:12px;background:#f8faff;margin-top:10px">
<h3 style="margin-top:0">📐 Identificação do orçamento</h3>
<label>Nome do orçamento</label><input id="quoteName" placeholder="Ex.: Pintura externa"/>
<div class="row" style="display:none"><div><label>Tipo de obra</label><select id="workType"><option>Casa Nova</option><option>Comercial</option><option>Serviços e Reformas</option></select></div><div><label>Tipo de serviço</label><select id="serviceType"><option>Residencial</option><option>Comercial</option></select></div></div>
<label><input id="clientMaterial" type="checkbox" style="width:auto"> Material fornecido pelo cliente</label>

</div>
<div id="legacyServiceArea" style="display:none"><label>Serviço</label><select id="service" onchange="fields()"><option value="floor">Piso / Revestimento</option><option value="clean">Limpeza pós-obra</option><option value="paint">Pintura</option><option value="electric">Elétrica</option><option value="hydraulic">Hidráulica</option><option value="masonry">Alvenaria</option><option value="other">Outro serviço</option></select><div id="dynamic"></div></div>

<h3>Itens do orçamento</h3>
<div id="quoteItems"></div>
<div class="row" style="flex-wrap:wrap;gap:8px"><button class="gray" onclick="addQuoteItem()">➕ Adicionar item</button><button class="primary" onclick="addCustomQuoteService()">＋ Cadastrar novo serviço</button></div>
<div class="card" style="padding:12px;background:#f8faff;margin-top:10px">
<h3 style="margin-top:0">📸 Fotos do serviço</h3>
<p class="small">No dia da vistoria, tire as fotos normalmente com o celular. Depois, selecione aqui as imagens que já estão na galeria. Elas ficam salvas junto com este orçamento e não entram no PDF automaticamente.</p>
<label for="quotePhotosInput">Escolher fotos da galeria</label>
<input id="quotePhotosInput" type="file" accept="image/*" multiple onchange="recollAddQuotePhotos(this.files)" />
<div id="quotePhotosPreview" class="row" style="flex-wrap:wrap;gap:8px"></div>
</div>
<label>Observações</label><textarea id="obs" placeholder="Detalhes, inclusões e exclusões..." rows="3"></textarea>
<button class="primary" onclick="calculate()">Calcular orçamento</button>
<button class="gray" onclick="show('home')">Voltar</button>
<div id="result"></div>
</div>
<div class="card hidden" id="maintenance">
<h2>🏢 Manutenção de Condomínio</h2>
<div class="row"><div><label>Condomínio</label><input id="mcond" placeholder="Nome do condomínio"/></div><div><label>Responsável</label><input id="mresp" placeholder="Síndico / responsável"/></div></div>
<div class="row"><div><label>WhatsApp</label><input id="mphone" placeholder="(11) 99999-9999"/></div><div><label>Tipo</label><select id="mtype"><option>Orçamento de manutenção</option><option>Serviço executado</option></select></div></div>
<label>Descrição geral</label><textarea id="mdesc" placeholder="Explique o serviço, ambiente ou ocorrência..." rows="2"></textarea>
<div class="card" style="padding:12px;background:#f8faff">
<h3 style="margin-top:0">Itens da manutenção</h3>
<div id="items"></div>
<button class="primary" onclick="addItem()">➕ Adicionar item</button>
</div>
<div class="card" style="padding:12px;background:#f8faff">
<h3 style="margin-top:0">Fotos</h3>
<label>Fotos antes</label><input accept="image/*" multiple="" type="file"/>
<label>Fotos depois</label><input accept="image/*" multiple="" type="file"/>
</div>
<div class="total">Total: <span id="mtotal">R$ 0,00</span></div>
<button class="primary" onclick="saveMaintenance()">💾 Salvar</button>
<button class="green" onclick="makeMaintenancePDF()">📄 Gerar PDF</button>
<button class="green" onclick="shareMaintenanceWhatsApp()">📲 WhatsApp</button>
<button class="gray" onclick="show('home')">Voltar</button>
<div id="mresult"></div>
</div>
<div class="card hidden" id="inspection">
<h2>📸 Nova Vistoria</h2>
<label>Cliente</label><input id="vclient" placeholder="Nome do cliente"/>
<label>WhatsApp</label><input id="vphone" placeholder="(11) 99999-9999"/>
<div class="row"><div><label>Cidade</label><input id="vcity"/></div><div><label>Tipo</label><select id="vkind"><option>Particular</option><option>Construtora</option><option>Condomínio</option></select></div></div>
<label>Endereço</label><input id="vaddress"/>
<label>Tipo de imóvel</label><input id="vproperty" placeholder="Casa, apartamento, condomínio..."/>
<label>Fotos</label><input accept="image/*" id="vphotos" multiple="" type="file"/>
<label>Observações da vistoria</label><textarea id="vobs" placeholder="Ambientes, problemas e serviços necessários..." rows="4"></textarea>
<button class="primary" onclick="saveInspectionV4()">💾 Salvar vistoria</button>
<button class="primary" onclick="inspectionToQuoteV4()">➡️ Transformar em orçamento</button>
<button class="gray" onclick="show('home')">Voltar</button>
</div>
<div class="card hidden" id="pending">
<h2>📋 Pendências</h2>
<div id="pendingBox"></div>
<button class="gray" onclick="show('home')">Voltar</button>
</div>
<div class="card hidden" id="finance">
<h2>📊 Financeiro</h2>
<div id="financeBox"></div>
<button class="gray" onclick="show('home')">Voltar</button>
</div>
<div class="card hidden" id="works"><h2>📂 Minhas Obras</h2><div id="history">Nenhum registro salvo nesta sessão.</div><button class="gray" onclick="show('home')">Voltar</button></div>
<div class="card hidden" id="prices">
<h2>💰 Tabela de Preços</h2>
<h3>Pisos / Revestimentos</h3>
<p>Assentamento de porcelanato: <b>R$ 60/m² (preço inicial)</b></p><p>Rodapé 8 cm: <b>+10%</b></p>
<h3>Serviços cadastrados</h3>
<p class="small">Referências de mão de obra RECOLL. Materiais e produtos não estão incluídos e ficam por conta do cliente.</p>
<div id="priceList"></div>
<button class="primary" type="button" onclick="togglePriceForm()">➕ Cadastrar novo serviço</button>
<div id="newPriceForm" class="item hidden" style="margin-top:12px">
  <h3>Novo serviço RECOLL</h3>
  <label>Categoria</label>
  <select id="newPriceCategory"><option>Serviços diversos</option><option>Fundação</option><option>Alvenaria</option><option>Chapisco e reboco</option><option>Contrapiso</option><option>Porcelanato</option><option>Piso cerâmico</option><option>Revestimento de parede</option><option>Drywall</option><option>Pintura interna</option><option>Pintura externa</option><option>Impermeabilização</option><option>Limpeza pós-obra</option><option>Manutenção</option><option>Hidráulica</option><option>Elétrica</option></select>
  <label>Nome do serviço</label><input id="newPriceName" placeholder="Ex.: Assentamento de porcelanato" />
  <label>Unidade</label><select id="newPriceUnit"><option>m²</option><option>m</option><option>un.</option><option>hora</option><option>diária</option><option>serviço</option></select>
  <label>Preço da mão de obra (R$)</label><input id="newPriceValue" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00" />
  <p class="small">Somente mão de obra. Não incluir materiais nem produtos.</p>
  <button class="primary" type="button" onclick="saveNewPrice()">💾 Salvar serviço</button>
  <button class="gray" type="button" onclick="togglePriceForm(false)">Cancelar</button>
</div>
<p class="small">Os serviços cadastrados ficam salvos neste aparelho e poderão ser selecionados nos próximos orçamentos.</p>
<button class="gray" onclick="show('home')">Voltar</button>
</div>
<div class="card hidden" id="settings">
<h2>⚙️ Configurações</h2>
<label>Nome da empresa</label><input id="company" value="RECOLL"/>
<label>WhatsApp da empresa</label><input id="companyPhone" placeholder="(11) 99999-9999"/>
<label>CNPJ</label><input id="cnpj" placeholder="00.000.000/0000-00"/>
<label>Instagram / site</label><input id="social" placeholder="@recoll.limpeza"/>
<label>Logo da empresa</label><input accept="image/*" id="logoFile" onchange="loadLogo(event)" type="file"/>
<div id="logoPreview"></div>
<button class="primary" onclick="saveSettings()">Salvar dados</button><button class="gray" onclick="show('home')">Voltar</button>
<p class="small">O logo é ajustado proporcionalmente, sem esticar.</p>
</div>
<div class="card hidden" id="contract">
<h2>📑 Contrato</h2>
<div class="tag" id="contractStatus">Nenhum orçamento aprovado</div>
<div class="card" style="padding:12px;background:#f8faff">
<h3 style="margin-top:0">Dados do contrato</h3>
<label>Contratante / Cliente</label><input id="cclient"/>
<div class="row"><div><label>WhatsApp</label><input id="cphone"/></div><div><label>Tipo de cliente</label><input id="ckind"/></div></div>
<label>Endereço da obra</label><input id="caddress"/>
<div class="row"><div><label>Cidade</label><input id="ccity"/></div><div><label>Valor contratado</label><input id="cvalue"/></div></div>
<label>Objeto / Serviços contratados</label><textarea id="cservices" rows="4"></textarea>
<div class="row"><div><label>Prazo de execução</label><input id="cdeadline" placeholder="Ex.: 10 dias úteis"/></div><div><label>Forma de pagamento</label><input id="cpayment" placeholder="Ex.: 50% início / 50% entrega"/></div></div>
<label>O que está incluso</label><textarea id="cincluded" placeholder="Serviços incluídos no orçamento..." rows="3"></textarea>
<label>O que não está incluso</label><textarea id="cexcluded" placeholder="Serviços ou materiais não incluídos..." rows="3"></textarea>
<label>Observações / condições</label><textarea id="cobs" rows="3"></textarea>
</div>
<button class="primary" onclick="approveQuote()">✅ Aprovar orçamento</button>
<button class="green" onclick="makeContractPDF()">📄 Gerar contrato</button>
<button class="green" onclick="shareContractWhatsApp()">📲 WhatsApp</button>
<button class="gray" onclick="show('home')">Voltar</button>
</div>
<div class="hidden" id="printArea"></div>
</main>
<script>
let currentQuote=null,items=[],itemCounter=0,quoteItems=[],quoteItemCounter=0,editingQuoteNumber=null,recollQuotePhotos=[];
const $=id=>document.getElementById(id);
function show(id){['home','new','maintenance','inspection','pending','finance','works','prices','settings','contract','execution','obras-v9','calculadoraPrecos','assistenteOrcamento','termoEntregaV14'].forEach(x=>{if($(x))$(x).classList.add('hidden')});if($(id))$(id).classList.remove('hidden');if(id==='works'){renderHistory();if($('obras-v9'))$('obras-v9').classList.remove('hidden');}if(id==='prices')renderPrices();if(id==='pending')renderPendingV4();if(id==='finance')renderFinanceV4();}
function brl(v){return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
const SINAPI_CATEGORIAS=[
'Mobilização / Desmob.','Demolição + Descarte','Contrapiso','Construção','Piscina','Telhados e Coberturas','Louças e Metais','Elétrica','Hidráulica','Climatização','Iluminação','Pintura','Impermeabilização','Revestimentos','Esquadrias','Reboco / Regularização','Fachada','Áreas Externas','Serviços Finais','Gerais / Outros'
];
const RECOLL_SERVICOS_CATEGORIA={
  'Pintura':[['Preparação de paredes','m²'],['Pintura de paredes','m²'],['Pintura de tetos','m²'],['Pintura de portas','un.']],
  'Revestimentos':[['Assentamento de piso','m²'],['Assentamento de porcelanato','m²'],['Assentamento de revestimento','m²'],['Rodapé','m'],['Rejuntamento','m²']],
  'Elétrica':[['Tomada/interruptor','un.'],['Instalação de luminária','un.'],['Reparo elétrico','serviço']],
  'Hidráulica':[['Troca de torneira','un.'],['Troca de sifão','un.'],['Reparo de vazamento','serviço']],
  'Construção':[['Alvenaria','m²'],['Mão de obra','h'],['Serviço de construção','serviço']],
  'Demolição + Descarte':[['Demolição de revestimento cerâmico','m²'],['Retirada e descarte de entulho','m³']],
  'Contrapiso':[['Execução de contrapiso','m²'],['Regularização de piso','m²']],
  'Telhados e Coberturas':[['Manutenção de telhado','m²'],['Instalação de telhas','m²']],
  'Louças e Metais':[['Instalação de louça sanitária','un.'],['Instalação de metais','un.']],
  'Climatização':[['Instalação de equipamento','un.'],['Manutenção de climatização','serviço']],
  'Iluminação':[['Instalação de luminária','un.'],['Instalação de iluminação','serviço']],
  'Impermeabilização':[['Impermeabilização de piso','m²'],['Impermeabilização de parede','m²']],
  'Esquadrias':[['Instalação de porta','un.'],['Instalação de janela','un.']],
  'Reboco / Regularização':[['Reboco de parede','m²'],['Regularização de superfície','m²']],
  'Fachada':[['Preparação de fachada','m²'],['Pintura de fachada','m²']],
  'Áreas Externas':[['Calçada','m²'],['Piso externo','m²']],
  'Serviços Finais':[['Salvapiso','m²'],['Limpeza geral de obra','m²'],['Remoção de entulho','m³']],
  'Mobilização / Desmob.':[['Mobilização','serviço'],['Desmobilização','serviço']],
  'Piscina':[['Execução/manutenção de piscina','serviço']],
  'Gerais / Outros':[['Serviço personalizado','serviço']]
};
let sinapiSelectedCategories=[];
let sinapiSelectedServices=[];
// Base preparada para receber o relatório oficial SINAPI. Não inventa preço: sem custo publicado, mostra aviso.
const SINAPI_REFERENCIAS={
  // Referência SP — Ago/2026, valores desonerados consultados em base pública que identifica a fonte como Caixa/IBGE.
  'Pintura|Preparação de paredes':{codigo:'88485',preco:4.99,ref:'08/2026'},
  'Pintura|Pintura de paredes':{codigo:'88489',preco:14.99,ref:'08/2026'},
  'Pintura|Pintura de tetos':{codigo:'88488',preco:17.99,ref:'08/2026'},
  'Elétrica|Tomada/interruptor':{codigo:'91995',preco:34.00,ref:'08/2026'},
  'Louças e Metais|Troca de torneira':{codigo:'86910',preco:127.55,ref:'07/2026'},
  'Revestimentos|Assentamento de revestimento':{codigo:'87265',preco:61.11,ref:'08/2026'},
  // Preço comercial inicial definido pelo usuário para a tabela RECOLL; não é preço oficial SINAPI.
  'Revestimentos|Assentamento de porcelanato':{codigo:'RECOLL',preco:60.00,ref:'Tabela comercial RECOLL',unidade:'m²',comercial:true},
  'Esquadrias|Instalação de porta':{codigo:'90790',preco:1066.28,ref:'08/2026'},
  // Limpeza geral: referência técnica SINAPI 99803 (limpeza de piso cerâmico/porcelanato).
  // R$ 21,52362/m² é APENAS um valor de teste derivado do exemplo mostrado pelo usuário (500 m² = R$ 10.761,81).
  // Não representa preço oficial do SINAPI e deverá ser substituído pela tabela comercial RECOLL definitiva.
  'Serviços Finais|Limpeza geral de obra':{codigo:'99803',preco:21.52362,ref:'teste-RECOLL',unidade:'m²'}
};

// Serviços genéricos podem ter mais de uma composição SINAPI possível.
// O usuário escolhe a composição antes de calcular, evitando preço inventado.
const SINAPI_ALTERNATIVAS={
  'Impermeabilização|Impermeabilização de piso':[
    {codigo:'98555',preco:36.56,ref:'08/2026',descricao:'Impermeabilização de superfície com argamassa polimérica / membrana acrílica, 3 demãos',unidade:'m²'},
    {codigo:'98562',preco:58.15,ref:'08/2026',descricao:'Impermeabilização de superfície com argamassa de cimento e areia, com aditivo impermeabilizante, e=1,5 cm',unidade:'m²'},
    {codigo:'98554',preco:50.92,ref:'08/2026',descricao:'Impermeabilização de superfície com membrana à base de resina acrílica, 3 demãos',unidade:'m²'},
    {codigo:'98546',preco:135.46,ref:'08/2026',descricao:'Impermeabilização de superfície com manta asfáltica, uma camada, inclusive primer, e=4 mm',unidade:'m²'}
  ],
  'Impermeabilização|Impermeabilização de parede':[
    {codigo:'98555',preco:36.56,ref:'08/2026',descricao:'Impermeabilização de superfície com argamassa polimérica / membrana acrílica, 3 demãos',unidade:'m²'},
    {codigo:'98554',preco:50.92,ref:'08/2026',descricao:'Impermeabilização de superfície com membrana à base de resina acrílica, 3 demãos',unidade:'m²'},
    {codigo:'98562',preco:58.15,ref:'08/2026',descricao:'Impermeabilização de superfície com argamassa de cimento e areia, com aditivo impermeabilizante, e=1,5 cm',unidade:'m²'}
  ]
};
function sinapiAlternativaKey(s){return s.refSelecionada||s.key;}
function getSinapiRef(s){return SINAPI_REFERENCIAS[sinapiAlternativaKey(s)] || (s.refSelecionada && SINAPI_ALTERNATIVAS[s.key] ? SINAPI_ALTERNATIVAS[s.key].find(x=>x.codigo===s.refSelecionada) : null);}
function renderSinapiCategories(){
 const box=$('sinapiCategories'); if(!box)return;
 box.innerHTML=SINAPI_CATEGORIAS.map(c=>`<button type="button" class="sinapi-cat ${sinapiSelectedCategories.includes(c)?'selected':''}" onclick='toggleSinapiCategory(${JSON.stringify(c)})'>${sinapiSelectedCategories.includes(c)?'✓ ':''}${c}</button>`).join('');
 renderSinapiServices();
}
function toggleSinapiCategory(c){
 const i=sinapiSelectedCategories.indexOf(c);
 if(i>=0){
   sinapiSelectedCategories.splice(i,1);
   // Ao retirar uma categoria, seus serviços também deixam de ficar selecionados.
   // Isso evita que um serviço de uma categoria antiga continue aparecendo no relatório.
   sinapiSelectedServices=sinapiSelectedServices.filter(s=>s.category!==c);
 } else {
   sinapiSelectedCategories.push(c);
 }
 renderSinapiCategories();
}
function categoryChanged(){renderSinapiCategories();}
function renderSinapiServices(){
 const box=$('sinapiServiceBox'),info=$('sinapiCategoryInfo'); if(!box)return;
 const selectedBox=$('sinapiSelectedBox');
 if(!sinapiSelectedCategories.length){box.innerHTML='';if(info)info.textContent='Toque em uma ou mais categorias acima para ver os serviços.';if(selectedBox){selectedBox.style.display='none';selectedBox.innerHTML='';}return;}
 if(info)info.innerHTML='<b>Agora selecione um ou mais serviços.</b> Toque nos botões abaixo e informe a quantidade. Em <b>Serviços Finais</b>, o sistema segue o modelo da tela de Limpeza pós obra: Salvapiso, Limpeza geral de obra e Remoção de entulho. A referência técnica é vinculada automaticamente; o preço comercial RECOLL ficará separado da referência SINAPI.';
 const rows=[];
 sinapiSelectedCategories.forEach(c=>{
   const lista=RECOLL_SERVICOS_CATEGORIA[c]||[];
   rows.push(`<div class="sinapi-service-category"><div class="sinapi-service-title">${c}</div>${c==='Serviços Finais'?'<div class="small" style="margin:6px 0 10px">Preencha o requisito de cada serviço (ex.: 500 m²). O cálculo será quantidade × preço da tabela RECOLL vinculada à referência técnica.</div>':''}<div class="sinapi-service-grid">`);
   lista.forEach((x,i)=>{
     const key=c+'|'+x[0], checked=sinapiSelectedServices.some(s=>s.key===key), ref=SINAPI_REFERENCIAS[key];
     rows.push(`<button type="button" class="sinapi-service-btn ${checked?'selected':''}" onclick='toggleSinapiService(${JSON.stringify(c)},${i},${!checked})'><span class="check">${checked?'✓':'＋'}</span><span><b>${x[0]}</b><small>${x[1]}${ref?' · RECOLL '+brl(ref.preco)+'/'+(ref.unidade||x[1]):' · preço RECOLL aguardando composição'}</small></span></button>`);
   });
   rows.push('</div></div>');
 });
 box.innerHTML=rows.join('');
 if(selectedBox){
   selectedBox.style.display=sinapiSelectedServices.length?'block':'none';
   selectedBox.innerHTML=sinapiSelectedServices.length?'<h3 style="margin-top:0">✅ Serviços selecionados</h3>'+sinapiSelectedServices.map((s,i)=>{const r=getSinapiRef(s), alts=SINAPI_ALTERNATIVAS[s.key]||[];return `<div class="item" style="margin:8px 0;padding:10px"><b>${i+1}. ${s.name}</b><div class="small">${s.category} · referência: ${r?(r.comercial?'tabela comercial RECOLL':'SINAPI '+r.codigo)+' · preço RECOLL '+brl(r.preco)+'/'+(r.unidade||s.unit):'aguardando composição'}</div>${alts.length?`<label>Composição SINAPI</label><select onchange="setSinapiRef(${JSON.stringify(s.key)},this.value)"><option value="">Selecione a composição correta</option>${alts.map(a=>`<option value="${a.codigo}" ${s.refSelecionada===a.codigo?'selected':''}>${a.codigo} — ${a.descricao} — ${brl(a.preco)}/${a.unidade}</option>`).join('')}</select>`:''}<div class="row"><div><label>Quantidade</label><input id="sinapiQty_${i}" type="number" min="0" step="0.01" inputmode="decimal" value="${s.qty ?? 0}" oninput="setSinapiQty(${JSON.stringify(s.key)},this.value)"></div><div><label>Unidade</label><select onchange="setSinapiUnit(${JSON.stringify(s.key)},this.value)">
<option value="m²" ${s.unitSelecionada==='m²'?'selected':''}>m²</option>
<option value="m" ${s.unitSelecionada==='m'?'selected':''}>m (metro linear)</option>
<option value="unidade" ${s.unitSelecionada==='unidade'?'selected':''}>Unidade</option>
<option value="hora" ${s.unitSelecionada==='hora'?'selected':''}>Hora</option>
<option value="diária" ${s.unitSelecionada==='diária'?'selected':''}>Diária</option>
<option value="serviço" ${s.unitSelecionada==='serviço'?'selected':''}>Serviço</option>
</select></div></div>${r?`<div class="small">Preço unitário RECOLL: <b>${brl(r.preco)}</b> / ${r.unidade||s.unit}<br><span class="small">${r.comercial?'Tabela comercial RECOLL':'Referência técnica SINAPI: '+r.codigo} (${r.ref||'sem mês informado'})</span></div><div class="small" style="margin-top:4px">Subtotal: <b>${brl((Number(r.preco)||0)*(Number(s.qty)||0))}</b></div>`:''}${r&&r.unidade&&r.unidade!==s.unitSelecionada?'<div class="small" style="color:#8a6d00">⚠️ A unidade da composição SINAPI é '+r.unidade+'. Confira antes de calcular.</div>':''}</div>`}).join(''):'';
 }
}
function toggleSinapiService(c,i,on){
 const x=(RECOLL_SERVICOS_CATEGORIA[c]||[])[i]; if(!x)return; const key=c+'|'+x[0];
 if(on){
   if(!sinapiSelectedServices.some(s=>s.key===key)){
     const unidadeInicial = x[1]==='h'?'hora':(x[1]==='un.'?'unidade':(['m²','m','diária','serviço'].includes(x[1])?x[1]:'unidade'));
     sinapiSelectedServices.push({key,category:c,name:x[0],unit:x[1],unitSelecionada:unidadeInicial,qty:0});
   }
 } else {
   sinapiSelectedServices=sinapiSelectedServices.filter(s=>s.key!==key);
 }
 renderSinapiServices();
}
function setSinapiQty(key,v){const s=sinapiSelectedServices.find(x=>x.key===key);if(s){const n=parseFloat(String(v).replace(',','.'));s.qty=Number.isFinite(n)?n:0;}}
function syncSinapiQuantitiesFromScreen(){sinapiSelectedServices.forEach((s,i)=>{const el=document.getElementById('sinapiQty_'+i);if(el){const n=parseFloat(String(el.value).replace(',','.'));s.qty=Number.isFinite(n)?n:0;}});}
function setSinapiUnit(key,v){const s=sinapiSelectedServices.find(x=>x.key===key);if(s){s.unitSelecionada=v;renderSinapiServices();}}
function setSinapiRef(key,codigo){const s=sinapiSelectedServices.find(x=>x.key===key);if(s){s.refSelecionada=codigo||'';renderSinapiServices();}}
function sinapiTotal(){return sinapiSelectedServices.reduce((sum,s)=>{const r=getSinapiRef(s);return sum+(r?(Number(r.preco)||0)*(Number(s.qty)||0):0)},0)}
function sinapiMissing(){return sinapiSelectedServices.filter(s=>!getSinapiRef(s));}
function renderSinapiSummary(){
 const missing=sinapiMissing();
 const total=sinapiTotal();
 return `<div class="card" style="padding:12px;background:#f8faff"><b>Composição do orçamento RECOLL + referência SINAPI</b><p class="small">${sinapiSelectedServices.length} serviço(s) selecionado(s).</p><p class="small">Cada item é calculado por <b>quantidade × preço unitário</b>.</p><p class="small">A referência SINAPI identifica tecnicamente o serviço. O cálculo do orçamento usa o preço da tabela comercial RECOLL.</p>${missing.length?`<div class="sinapi-empty">${missing.length} serviço(s) ainda sem preço RECOLL cadastrado. Não será usado preço base inventado.</div>`:''}<div class="total">Valor de referência RECOLL: ${brl(total)}</div></div>`;
}

function fields(){let s=$('service').value,d=$('dynamic');
if(s==='floor')d.innerHTML='<label>Área (m²)</label><input id="area" type="number" step="0.01" placeholder="Ex.: 150"><label>Tipo</label><select id="ft"><option value="60">Porcelanato — R$ 60/m²</option></select><label><input id="baseboard" type="checkbox" style="width:auto"> Incluir rodapé 8 cm (+10%)</label>';
else if(s==='clean')d.innerHTML='<div class="row"><div><label>Profissionais</label><input id="pros" type="number" value="1"></div><div><label>Dias</label><input id="days" type="number" value="1"></div></div><div class="row"><div><label>Diária profissional</label><input id="pd" type="number" value="150"></div><div><label>Sua diária</label><input id="ud" type="number" value="300"></div></div><div class="row"><div><label>Combustível</label><input id="fuel" type="number" value="0"></div><div><label>Produtos</label><input id="prod" type="number" value="0"></div></div><label>Outros custos</label><input id="othercost" type="number" value="0">';
else d.innerHTML='<label>Quantidade</label><input id="qty" type="number" value="1"><label>Preço base por unidade/m²</label><input id="base" type="number" value="0">';
}
fields();


const RECOLL_TABELA_REFERENCIA = {
  'Serviços diversos': [
    {desc:'Serviço personalizado',unit:'serviço',price:0}
  ],
  'Fundação': [
    {desc:'Mão de obra de fundação',unit:'m²',price:220}
  ],
  'Alvenaria': [
    {desc:'Execução de alvenaria',unit:'m²',price:100}
  ],
  'Chapisco e reboco': [
    {desc:'Chapisco',unit:'m²',price:15},
    {desc:'Reboco',unit:'m²',price:45}
  ],
  'Contrapiso': [
    {desc:'Execução de contrapiso',unit:'m²',price:45}
  ],
  'Porcelanato': [
    {desc:'Assentamento de porcelanato',unit:'m²',price:60}
  ],
  'Piso cerâmico': [
    {desc:'Assentamento de piso cerâmico',unit:'m²',price:60}
  ],
  'Revestimento de parede': [
    {desc:'Assentamento de revestimento de parede',unit:'m²',price:70}
  ],
  'Drywall': [
    {desc:'Instalação de drywall',unit:'m²',price:95}
  ],
  'Pintura interna': [
    {desc:'Pintura interna com preparação',unit:'m²',price:35},
    {desc:'Pintura interna simples',unit:'m²',price:22}
  ],
  'Pintura externa': [
    {desc:'Pintura externa',unit:'m²',price:28}
  ],
  'Impermeabilização': [
    {desc:'Impermeabilização com produto aplicado',unit:'m²',price:50}
  ],
  'Limpeza pós-obra': [
    {desc:'Limpeza pós-obra — obra grande / menor dificuldade',unit:'m²',price:9},
    {desc:'Limpeza pós-obra — preço padrão RECOLL',unit:'m²',price:10},
    {desc:'Limpeza pós-obra — mais detalhada / maior dificuldade',unit:'m²',price:11}
  ]
};
// Recarrega serviços personalizados cadastrados pelo usuário neste aparelho.
(function loadCustomQuoteServices(){
 try {
   const saved=JSON.parse(localStorage.getItem('recoll_custom_quote_services')||'[]');
   saved.forEach(item=>{
     if(!item || !item.category || !item.desc) return;
     if(!RECOLL_TABELA_REFERENCIA[item.category]) RECOLL_TABELA_REFERENCIA[item.category]=[];
     if(!RECOLL_TABELA_REFERENCIA[item.category].some(x=>x.desc===item.desc)) RECOLL_TABELA_REFERENCIA[item.category].push({desc:item.desc,unit:item.unit||'serviço',price:Number(item.price)||0});
   });
 } catch(e) { console.warn('Não foi possível carregar serviços personalizados.',e); }
})();
function addCustomQuoteService(){
 const category=prompt('Categoria do serviço (ex.: Alvenaria, Pintura interna):','Serviços diversos');
 if(!category || !category.trim()) return;
 const cat=category.trim();
 const desc=prompt('Nome do novo serviço:');
 if(!desc || !desc.trim()) return;
 const unit=(prompt('Unidade (m², m, unidade, hora, diária ou serviço):','m²')||'m²').trim();
 const raw=prompt('Preço inicial de referência em reais (ex.: 60):','0');
 if(raw===null) return;
 const price=Number(String(raw).replace(',','.'));
 if(!Number.isFinite(price)||price<0){alert('Digite um preço válido, igual ou maior que zero.');return;}
 if(!RECOLL_TABELA_REFERENCIA[cat]) RECOLL_TABELA_REFERENCIA[cat]=[];
 if(RECOLL_TABELA_REFERENCIA[cat].some(x=>x.desc.toLowerCase()===desc.trim().toLowerCase())){alert('Esse serviço já existe nessa categoria.');return;}
 const item={category:cat,desc:desc.trim(),unit:unit||'serviço',price};
 RECOLL_TABELA_REFERENCIA[cat].push({desc:item.desc,unit:item.unit,price:item.price});
 const saved=JSON.parse(localStorage.getItem('recoll_custom_quote_services')||'[]');saved.push(item);localStorage.setItem('recoll_custom_quote_services',JSON.stringify(saved));
 renderQuoteItems();
 alert('Serviço cadastrado! Ele ficará disponível na tabela deste aparelho.');
}
function addQuoteItem(){let id=++quoteItemCounter;quoteItems.push({id,category:'Porcelanato',desc:'Assentamento de porcelanato',qty:1,unit:'m²',price:60});renderQuoteItems();}
function renderQuoteItems(){
 let box=$('quoteItems');if(!box)return;
 const cats=Object.keys(RECOLL_TABELA_REFERENCIA);
 box.innerHTML=quoteItems.map((it,i)=>{
   const services=RECOLL_TABELA_REFERENCIA[it.category]||[];
   return `<div class="item"><div class="itemHead"><b>Item ${i+1}</b><button class="danger" onclick="removeQuoteItem(${it.id})">Excluir</button></div>
   <label>Categoria</label><select onchange="setQuoteItemCategory(${it.id},this.value)">${cats.map(c=>`<option value="${c}" ${it.category===c?'selected':''}>${c}</option>`).join('')}</select>
   <label>Serviço</label><select onchange="setQuoteItemService(${it.id},this.value)">${services.map((x,j)=>`<option value="${j}" ${it.desc===x.desc?'selected':''}>${x.desc} — ${brl(x.price)}/${x.unit}</option>`).join('')}</select>
   <div class="row"><div><label>Quantidade</label><input type="number" min="0" step="0.01" value="${it.qty}" onchange="setQuoteItem(${it.id},'qty',this.value)"></div><div><label>Unidade</label><input value="${it.unit}" onchange="setQuoteItem(${it.id},'unit',this.value)"></div></div>
   <div class="row"><div><label>Preço unitário (R$)</label><input type="number" min="0" step="0.01" value="${it.price}" onchange="setQuoteItem(${it.id},'price',this.value)"></div><div><label>Total do item</label><input value="${brl(it.qty*it.price)}" readonly></div></div>
   <div class="small">Preço de referência comercial RECOLL; ajuste conforme a cidade e as condições da obra. Não é cotação oficial SINAPI.</div></div>`;
 }).join('');
}
function setQuoteItemCategory(id,category){
 const it=quoteItems.find(x=>x.id===id);if(!it)return;
 const first=(RECOLL_TABELA_REFERENCIA[category]||[])[0];if(!first)return;
 Object.assign(it,{category,desc:first.desc,unit:first.unit,price:first.price});renderQuoteItems();
}
function setQuoteItemService(id,index){
 const it=quoteItems.find(x=>x.id===id);if(!it)return;
 const x=(RECOLL_TABELA_REFERENCIA[it.category]||[])[Number(index)];if(!x)return;
 it.desc=x.desc;it.unit=x.unit;it.price=x.price;renderQuoteItems();
}
function setQuoteItem(id,k,v){let it=quoteItems.find(x=>x.id===id);if(!it)return;it[k]=(k==='qty'||k==='price')?(parseFloat(String(v).replace(',','.'))||0):v;renderQuoteItems();}
function removeQuoteItem(id){quoteItems=quoteItems.filter(x=>x.id!==id);renderQuoteItems();}

function quoteItemsTotal(){return quoteItems.reduce((a,x)=>a+x.qty*x.price,0);}

function calculate(){
 if(sinapiSelectedServices.length){
   syncSinapiQuantitiesFromScreen();
   const missing=sinapiMissing();
   if(missing.length){
     $('result').innerHTML=renderSinapiSummary()+`<p class="small">Para calcular o valor final, precisamos carregar o preço da tabela RECOLL para a referência escolhida. O código SINAPI serve como rastreabilidade técnica; o aplicativo não inventará preço.</p><button class="gray" onclick="show('home')">Voltar</button>`;
     return;
   }
   const total=sinapiTotal();
   currentQuote={client:$('client').value||'Cliente',phone:$('phone').value,city:$('sinapiCity').value.trim()||$('city').value,kind:$('kind').value,address:$('address').value,service:'SINAPI',desc:sinapiSelectedServices.map(s=>`${s.qty} ${s.unitSelecionada||s.unit} — ${s.name}`).join('; '),total,items:sinapiSelectedServices.map(s=>({...s,sinapi:getSinapiRef(s)})),obs:$('obs').value,date:currentQuote&&editingQuoteNumber?currentQuote.date:new Date().toLocaleDateString('pt-BR'),number:editingQuoteNumber||('REC-'+Date.now().toString().slice(-6)),status:(currentQuote&&currentQuote.approved)?'Aprovado':'Rascunho',approved:(currentQuote&&currentQuote.approved)||false};
   $('result').innerHTML=renderSinapiSummary()+`<div class="card"><div class="total">Valor total: ${brl(total)}</div><button class="primary" onclick="saveQuote()">💾 Salvar</button><button class="green" onclick="makePDF()">📄 Gerar PDF</button><button class="green" onclick="shareWhatsApp()">📲 WhatsApp</button><button class="primary" onclick="openContractFromQuote()">📑 Contrato</button></div>`;
   return;
 }
 let s=$('service').value,total=0,desc='';
 if(s==='floor'){let a=+($('area').value||0),p=+$('ft').value;total=a*p*($('baseboard').checked?1.10:1);desc=`${a} m² — ${$('ft').selectedOptions[0].text}`;}
 else if(s==='clean'){let cost=(+$('pros').value||0)*(+$('pd').value||0)*(+$('days').value||0)+(+($('ud').value||0)*(+$('days').value||0))+(+$('fuel').value||0)+(+($('prod').value||0))+(+$('othercost').value||0);total=cost/0.60;desc='Limpeza pós-obra — custo total dividido por 60%';}
 else{total=(+$('qty').value||0)*(+$('base').value||0);desc=$('service').selectedOptions[0].text;}
 if(quoteItems.length) total=quoteItemsTotal();
 currentQuote={client:$('client').value||'Cliente',phone:$('phone').value,city:$('city').value,kind:$('kind').value,address:$('address').value,service:$('service').selectedOptions[0].text,desc,total,items:JSON.parse(JSON.stringify(quoteItems)),obs:$('obs').value,date:currentQuote&&editingQuoteNumber?currentQuote.date:new Date().toLocaleDateString('pt-BR'),number:editingQuoteNumber||('REC-'+Date.now().toString().slice(-6)),status:(currentQuote&&currentQuote.approved)?'Aprovado':'Rascunho',approved:(currentQuote&&currentQuote.approved)||false};
 $('result').innerHTML=`<div class="card"><div class="small">Valor total do orçamento</div><div class="total">${brl(total)}</div><p>${desc}</p><button class="primary" onclick="saveQuote()">💾 Salvar</button><button class="green" onclick="makePDF()">📄 Gerar PDF</button><button class="green" onclick="shareWhatsApp()">📲 WhatsApp</button><button class="primary" onclick="openContractFromQuote()">📑 Contrato</button></div>`;
}
function recollPdfEscape(t){return String(t??'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)');}
function recollCustomerObs(value){return String(value??'').split(/\r?\n/).map(x=>x.trim()).filter(x=>!(/acrescentar\s+10%.*rodap[eé]s?/i.test(x)||/10%.*sobre\s+o\s+rodap[eé]s?/i.test(x))).join('\n').trim();}
function recollMakePdfBlob(q){
 const esc=t=>String(t??'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)');
 // O PDF usa fontes padrão e uma diagramação A4 legível, com total destacado.
 const clean=t=>String(t??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\x20-\x7E]/g,' ');
 const lines=[];
 lines.push({text:'RECOLL',size:22,bold:true,space:26});
 lines.push({text:'ORCAMENTO DE SERVICOS',size:13,bold:true,space:24});
 lines.push({text:'Numero: '+(q.number||''),size:11,space:17});
 lines.push({text:'Data: '+(q.date||''),size:11,space:17});
 lines.push({text:'Cliente: '+(q.client||''),size:11,space:17});
 lines.push({text:'WhatsApp: '+(q.phone||''),size:11,space:17});
 lines.push({text:'Cidade: '+(q.city||''),size:11,space:17});
 lines.push({text:'Endereco da obra: '+(q.address||''),size:11,space:24});
 lines.push({text:'SERVICOS CONTRATADOS',size:13,bold:true,space:22});
 (q.items||[]).forEach((it,i)=>{
   const r=it.sinapi, unit=it.unitSelecionada||it.unit||(r&&r.unidade)||'servico';
   const qty=Number(it.qty)||0, price=r&&Number(r.preco), subtotal=Number.isFinite(price)?qty*price:null;
   lines.push({text:(i+1)+'. '+(it.name||it.desc||'Servico'),size:11,bold:true,space:17});
   lines.push({text:'Quantidade: '+qty+' '+unit,size:10,space:15});
   if(subtotal!==null){lines.push({text:'Preco unitario RECOLL: '+Number(price).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:5})+' / '+unit,size:10,space:15});lines.push({text:'Subtotal: '+brl(subtotal),size:10,bold:true,space:20});}
   else lines.push({text:'Preco unitario: a confirmar',size:10,space:20});
 });
 lines.push({text:'VALOR TOTAL DO ORCAMENTO',size:12,bold:true,space:22});
 lines.push({text:brl(q.total||0),size:20,bold:true,space:30});
 const customerObs=recollCustomerObs(q.obs); if(customerObs){lines.push({text:'OBSERVACOES',size:12,bold:true,space:20});customerObs.split(/\n/).forEach(x=>lines.push({text:x,size:10,space:15}));}
 lines.push({text:'RECOLL - reforma, construcao e limpeza',size:10,space:20});
 // Wrap text to fit A4 at 11-pt equivalent.
 const wrapped=[];
 for(const ln of lines){const t=clean(ln.text); const max=ln.size>=18?42:ln.size>=12?65:88; const chunks=t.match(new RegExp('.{1,'+max+'}(?:\\s|$)|.{1,'+max+'}','g'))||['']; chunks.forEach((ch,i)=>wrapped.push({...ln,text:ch.trim(),space:i===chunks.length-1?ln.space:ln.size+4}));}
 const pages=[[]]; let y=790;
 for(const ln of wrapped){const needed=ln.space||16;if(y-needed<55){pages.push([]);y=790;} pages[pages.length-1].push({...ln,y});y-=needed;}
 const objs=[], add=x=>{objs.push(x);return objs.length};
 const f=add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
 const fb=add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
 const pageIds=[];
 for(const pg of pages){let stream='';
   stream+='0.10 0.25 0.48 rg 50 815 495 3 re f\n';
   for(const ln of pg){stream+='BT /'+(ln.bold?'F2':'F1')+' '+ln.size+' Tf 50 '+ln.y+' Td ('+esc(ln.text)+') Tj ET\n';}
   const c=add('<< /Length '+new TextEncoder().encode(stream).length+' >>\nstream\n'+stream+'endstream');
   const page=add('<< /Type /Page /Parent PAGES_REF /MediaBox [0 0 595 842] /Resources << /Font << /F1 '+f+' 0 R /F2 '+fb+' 0 R >> >> /Contents '+c+' 0 R >>');pageIds.push(page);
 }
 const pagesId=add('<< /Type /Pages /Kids ['+pageIds.map(id=>id+' 0 R').join(' ')+'] /Count '+pageIds.length+' >>');
 for(const id of pageIds)objs[id-1]=objs[id-1].replace('PAGES_REF',pagesId+' 0 R');
 const catalog=add('<< /Type /Catalog /Pages '+pagesId+' 0 R >>');
 let pdf='%PDF-1.4\n';const offsets=[0];for(let i=0;i<objs.length;i++){offsets.push(pdf.length);pdf+=(i+1)+' 0 obj\n'+objs[i]+'\nendobj\n';}const xref=pdf.length;pdf+='xref\n0 '+(objs.length+1)+'\n0000000000 65535 f \n';for(let i=1;i<=objs.length;i++)pdf+=String(offsets[i]).padStart(10,'0')+' 00000 n \n';pdf+='trailer\n<< /Size '+(objs.length+1)+' /Root '+catalog+' 0 R >>\nstartxref\n'+xref+'\n%%EOF';return new Blob([pdf],{type:'application/pdf'});
}
function recollPrintHtml(q){
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const logo=document.querySelector('#r39Logo img')?.src || document.querySelector('#headLogo img')?.src || '';
 const date=q.date||new Date().toLocaleDateString('pt-BR');
 const validity='15 dias';
 const items=(q.items||[]).map((it,i)=>{
   const ref=it.sinapi||((typeof getSinapiRef==='function')?getSinapiRef(it):null);
   const qty=Number(it.qty)||0;
   const unit=it.unitSelecionada||it.unit||(ref&&ref.unidade)||'serviço';
   // O PDF para o cliente mostra somente o preço comercial RECOLL; a referência técnica fica interna.
   const rawPrice=(it.price!==undefined&&it.price!==null)?Number(it.price):(ref&&ref.preco!==undefined?Number(ref.preco):null);
   const price=Number.isFinite(rawPrice)?rawPrice:null;
   const total=price===null?(qty>0 && q.items.length===1 ? Number(q.total)||0 : null):qty*price;
   const desc=it.desc||it.name||it.service||'Serviço';
   return `<tr><td>${i+1}</td><td>${esc(desc)}</td><td>${qty.toLocaleString('pt-BR',{maximumFractionDigits:2})}</td><td>${esc(unit)}</td><td>${price===null?'A confirmar':brl(price)}</td><td>${total===null?'A confirmar':brl(total)}</td></tr>`;
 }).join('');
 const fallbackItems=(!items && q.desc)?`<tr><td>1</td><td>${esc(q.desc)}</td><td>1</td><td>serviço</td><td>${brl(q.total||0)}</td><td>${brl(q.total||0)}</td></tr>`:'';
 const rows=items||fallbackItems;
 const photos=Array.isArray(q.photos)&&q.photos.length?`<div class="bar">Fotos da vistoria</div><div class="photoGrid">${q.photos.map((src,i)=>`<div class="photoItem"><img src="${src}" alt="Foto da vistoria ${i+1}"><small>Foto ${i+1}</small></div>`).join('')}</div>`:'';
 return `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orçamento RECOLL</title><style>
 @page{size:A4;margin:12mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#23334d;margin:0;font-size:11px}.head{display:flex;align-items:center;gap:14px;border-bottom:2px solid #1b58ce;padding-bottom:10px}.logo{width:76px;height:76px;object-fit:contain}.brand{flex:1}.brand h1{font-size:24px;color:#1556c8;margin:0 0 4px}.brand p{font-size:10px;font-weight:bold;margin:0}.slogan{color:#328653;font-style:italic;font-size:10px;text-align:right}.titleRow{display:flex;justify-content:space-between;align-items:center;margin:18px 0 14px}.titleRow h2{font-size:21px;color:#17417e;margin:0 auto}.meta{font-size:9px;line-height:1.8}.bar{background:#1558d5;color:#fff;font-weight:bold;padding:7px 12px;border-radius:4px;margin:14px 0 6px}.details{display:grid;grid-template-columns:105px 1fr;gap:5px;padding:3px 14px}.details b{color:#263448}table{width:100%;border-collapse:collapse;margin-top:20px;table-layout:fixed;font-size:9px}th{background:#1558d5;color:white;padding:8px 5px;text-align:left}td{border:1px solid #c7d0dd;padding:7px 5px;overflow-wrap:anywhere}th:nth-child(1){width:6%}th:nth-child(2){width:39%}th:nth-child(3){width:12%}th:nth-child(4){width:13%}th:nth-child(5){width:15%}th:nth-child(6){width:15%}td:nth-child(3),td:nth-child(4){text-align:center}.totalrow{display:flex;margin-top:0;background:#edf3ff;justify-content:flex-end;align-items:stretch;font-weight:bold}.totalrow span{padding:12px 16px}.totalrow strong{background:#1558d5;color:white;padding:12px 18px;font-size:15px;min-width:170px;text-align:right}.conditions{min-height:38px;padding:8px 14px;white-space:pre-wrap}.thanks{margin-top:18px;background:#e8f0ff;padding:18px;display:flex;justify-content:space-around;align-items:center;color:#254a86;border-radius:5px}.thanks strong{font-size:12px}.thanks em{font-size:14px}.signature{text-align:center;margin:16px auto 8px;width:260px;border-bottom:1px solid #7b8797;padding:0 0 5px}.signature small{display:block;margin-top:5px}.photoGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:6px 0 8px;break-inside:avoid}.photoItem{min-width:0;text-align:center;break-inside:avoid}.photoItem img{display:block;width:100%;aspect-ratio:1/1;height:auto;object-fit:cover;object-position:center;border:1px solid #c7d0dd;border-radius:3px}.photoItem small{display:block;font-size:7px;color:#667085;margin-top:2px}.foot{border-top:2px solid #1558d5;margin-top:18px;padding-top:9px;display:flex;justify-content:space-between;font-size:9px;color:#344054}@media print{body{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
 </style></head><body><div class="head"><img class="logo" src="${logo}" alt="RECOLL"><div class="brand"><h1>RECOLL</h1><p>REFORMA, CONSTRUÇÃO E LIMPEZA</p></div><div class="slogan">Espaços renovados para novas histórias!<br>━━━━━━━━━━━━</div></div>
 <div class="titleRow"><h2>ORÇAMENTO</h2><div class="meta">Nº: ${esc(q.number||'')}<br>Data: ${esc(date)}<br>Validade: ${validity}</div></div>
 <div class="bar">Cliente</div><div class="details"><b>Nome:</b><span>${esc(q.client||'')}</span><b>WhatsApp:</b><span>${esc(q.phone||'—')}</span><b>Tipo:</b><span>${esc(q.kind||'Particular')}</span></div>
 <div class="bar">Obra</div><div class="details"><b>Cidade:</b><span>${esc(q.city||'')}</span><b>Endereço:</b><span>${esc(q.address||'')}</span><b>Serviço:</b><span>${esc(q.service==='SINAPI'?'Serviços e Reformas':(q.service||'Serviços'))}</span></div>
 <table><thead><tr><th>#</th><th>Descrição</th><th>Qtd.</th><th>Unidade</th><th>Valor Unitário</th><th>Valor Total</th></tr></thead><tbody>${rows}</tbody></table>
 ${photos}
 <div class="totalrow"><span>Total do Orçamento</span><strong>${brl(q.total||0)}</strong></div>
 <div class="bar">Condições / Observações</div><div class="conditions">${esc(recollCustomerObs(q.obs)||'—')}</div>
 <div class="thanks"><div><strong>Obrigado pela oportunidade!</strong><br><br>Conte com a RECOLL para o sucesso da sua obra.</div><em>Qualidade<br>em cada detalhe<br><span style="color:#328653">━━━━━━━━━━━━</span></em></div>
 <div class="signature">&nbsp;<br><small>RECOLL<br>Responsável / Contratada</small></div><div class="foot"><span>WhatsApp: ${esc(q.companyPhone||'—')}</span><span>@recoll.limpeza</span><span>Santo André – ABC Paulista</span></div>
 <script>window.onload=()=>setTimeout(()=>window.print(),450);<\/script></body></html>`;
}
function makePDF(){
 if(!currentQuote){alert('Calcule o orçamento primeiro.');return;}
 currentQuote.photos=recollQuotePhotos.length?recollQuotePhotos.slice():(Array.isArray(currentQuote.photos)?currentQuote.photos:[]);
 const w=window.open('','_blank');
 if(!w){alert('O navegador bloqueou a janela de impressão. Permita pop-ups para o RECOLL.');return;}
 w.document.open();w.document.write(recollPrintHtml(currentQuote));w.document.close();
}
let recollPendingShareFile=null;
async function shareWhatsApp(){
 if(!currentQuote){alert('Calcule o orçamento primeiro.');return;}
 const q=currentQuote;
 // Inclui as fotos escolhidas nesta sessão mesmo antes de salvar o orçamento.
 q.photos=recollQuotePhotos.length?recollQuotePhotos.slice():(Array.isArray(q.photos)?q.photos:[]);
 const safeName=String(q.client||'Cliente').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9_-]+/g,'_').slice(0,40)||'Cliente';
 const filename='Orcamento_RECOLL_'+safeName+'.pdf';
 let host=null, styleNode=null, captureStyle=null;
 try{
   if(!window.html2pdf){
     await new Promise((resolve,reject)=>{
       const script=document.createElement('script');
       script.src='https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
       script.onload=resolve;script.onerror=()=>reject(new Error('Não foi possível carregar o gerador de PDF.'));
       document.head.appendChild(script);
     });
   }
   const parsed=new DOMParser().parseFromString(recollPrintHtml(q),'text/html');
   styleNode=document.createElement('style');
   styleNode.textContent=Array.from(parsed.querySelectorAll('style')).map(x=>x.textContent).join('\n').replace(/@page\{[^}]*\}/g,'');
   document.head.appendChild(styleNode);
   host=document.createElement('div');
   // Renderizar dentro da página, fora da área visível da interface, evita canvas branco
   // em alguns navegadores Android ao capturar um elemento position:fixed.
   host.style.cssText='position:absolute;left:0;top:0;width:700px;min-height:990px;background:#ffffff;color:#23334d;overflow:visible;opacity:1;pointer-events:none;';
   const body=parsed.body.cloneNode(true);
   body.querySelectorAll('script').forEach(x=>x.remove());
   host.innerHTML='<div class="recollPdfCapture">'+body.innerHTML+'</div>';
   captureStyle=document.createElement('style');
   captureStyle.textContent='.recollPdfCapture{width:700px;min-height:990px;background:#fff;color:#23334d;font-family:Arial,sans-serif;font-size:11px;padding:0}.recollPdfCapture .head{display:flex}.recollPdfCapture table{width:100%;border-collapse:collapse}.recollPdfCapture .bar,.recollPdfCapture th,.recollPdfCapture .totalrow strong{-webkit-print-color-adjust:exact;print-color-adjust:exact}';
   document.head.appendChild(captureStyle);
   document.body.appendChild(host);
   // Aguarda a logo e o layout estabilizarem antes da captura.
   await Promise.all(Array.from(host.querySelectorAll('img')).map(img=>img.decode ? img.decode().catch(()=>{}) : Promise.resolve()));
   await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
   const blob=await window.html2pdf().set({
     margin:[8,8,8,8],image:{type:'jpeg',quality:0.98},
     html2canvas:{scale:2,useCORS:true,backgroundColor:'#ffffff',logging:false,scrollX:0,scrollY:0},
     jsPDF:{unit:'mm',format:'a4',orientation:'portrait'},pagebreak:{mode:['css','legacy'],avoid:['.thanks','.signature','.foot']}
   }).from(host.firstElementChild).outputPdf('blob');
   document.head.removeChild(captureStyle);
   if(!blob || blob.size<1000) throw new Error('O PDF foi gerado vazio.');
   recollPendingShareFile=new File([blob],filename,{type:'application/pdf'});
   // O segundo toque preserva a autorização de compartilhamento do Android após a geração assíncrona do PDF.
   let old=document.getElementById('recollSharePanel');if(old)old.remove();
   const panel=document.createElement('div');panel.id='recollSharePanel';
   panel.style.cssText='position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:20px;';
   panel.innerHTML='<div style="background:#fff;color:#222;border-radius:14px;padding:22px;max-width:360px;width:100%;font:16px Arial,sans-serif;box-shadow:0 8px 32px #0004"><h3 style="margin:0 0 10px;color:#17417e">PDF pronto para enviar</h3><p style="line-height:1.45">O orçamento foi gerado no padrão RECOLL. Toque abaixo para abrir o compartilhamento do celular, escolha WhatsApp e selecione o cliente.</p><button id="recollShareNow" style="width:100%;padding:14px;border:0;border-radius:8px;background:#1558d5;color:white;font-size:16px;font-weight:bold">📲 Compartilhar PDF</button><button id="recollSaveInstead" style="width:100%;padding:12px;margin-top:8px;border:1px solid #bbb;border-radius:8px;background:white;color:#222;font-size:15px">Baixar PDF</button><button id="recollCancelShare" style="width:100%;padding:10px;margin-top:4px;border:0;background:white;color:#555;font-size:14px">Fechar</button></div>';
   document.body.appendChild(panel);
   document.getElementById('recollShareNow').onclick=async()=>{
     const file=recollPendingShareFile;
     if(!file){alert('Gere o PDF novamente.');return;}
     try{
       if(navigator.share){await navigator.share({title:'Orçamento RECOLL',text:'Orçamento '+(q.number||'')+' — RECOLL',files:[file]});panel.remove();}
       else {downloadRecollShareFile(file,filename);alert('Seu navegador não permite anexar o PDF diretamente. O arquivo foi baixado; no WhatsApp, use o clipe e escolha Documento.');}
     }catch(err){if(err && err.name==='AbortError')return;downloadRecollShareFile(file,filename);alert('O compartilhamento direto não foi aceito pelo celular. O PDF foi baixado; abra o WhatsApp, toque no clipe e escolha Documento para anexá-lo.');}
   };
   document.getElementById('recollSaveInstead').onclick=()=>downloadRecollShareFile(recollPendingShareFile,filename);
   document.getElementById('recollCancelShare').onclick=()=>panel.remove();
 }catch(err){console.error(err);alert('Não consegui gerar o PDF no padrão RECOLL. Confira a conexão com a internet e tente novamente.');}
 finally{if(host)host.remove();if(styleNode)styleNode.remove();if(captureStyle&&captureStyle.parentNode)captureStyle.remove();}
}
function downloadRecollShareFile(file,filename){
 if(!file)return;
 const url=URL.createObjectURL(file);const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);
}
function recollContractSettings(){try{return JSON.parse(localStorage.getItem('recoll_settings')||'{}')}catch(e){return {}}}
function openContractFromQuote(){
 if(!currentQuote){alert('Calcule o orçamento primeiro.');return}
 if($('cclient'))$('cclient').value=currentQuote.client||'';
 if($('cphone'))$('cphone').value=currentQuote.phone||'';
 if($('ckind'))$('ckind').value=currentQuote.kind||'';
 if($('caddress'))$('caddress').value=currentQuote.address||'';
 if($('ccity'))$('ccity').value=currentQuote.city||'';
 if($('cvalue'))$('cvalue').value=brl(currentQuote.total||0);
 let arr=currentQuote.items&&currentQuote.items.length?currentQuote.items:[{desc:currentQuote.desc||currentQuote.service,qty:1,unit:'serviço',price:currentQuote.total||0}];
 if($('cservices'))$('cservices').value=arr.map((x,i)=>'Item '+(i+1)+' — '+(x.desc||x.name||'Serviço')+' — '+(x.qty||1)+' '+(x.unit||'serviço')+' — '+brl((x.qty||1)*(x.price||0))).join('\n');
 if($('cobs'))$('cobs').value=currentQuote.obs||'';
 if($('contractStatus'))$('contractStatus').textContent=currentQuote.approved?'Orçamento aprovado':'Aguardando aprovação';
 show('contract');
}
function approveQuote(){
 if(!currentQuote){alert('Abra um orçamento primeiro.');return}
 currentQuote.approved=true; currentQuote.status='Aprovado';
 let h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]'); let idx=h.findIndex(x=>x.number===currentQuote.number);
 if(idx>=0)h[idx]=currentQuote; else h.unshift(currentQuote);
 localStorage.setItem('recoll_quotes',JSON.stringify(h));
 if($('contractStatus'))$('contractStatus').textContent='Orçamento aprovado';
 alert('Orçamento aprovado. O contrato pode ser gerado.');
}
let recollPendingContractFile=null;
function recollBuildContractHtml(){
 if(!currentQuote)throw new Error('Abra um orçamento primeiro.');
 const d=recollContractSettings();
 const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
 const client=$('cclient')?.value||currentQuote.client||'';
 const value=$('cvalue')?.value||brl(currentQuote.total||0);
 const services=$('cservices')?.value||currentQuote.desc||currentQuote.service||'';
 const deadline=$('cdeadline')?.value||'A definir';
 const payment=$('cpayment')?.value||'A definir';
 const included=$('cincluded')?.value||'Conforme orçamento aprovado.';
 const excluded=$('cexcluded')?.value||'Materiais e produtos não estão incluídos. Todos os materiais e produtos necessários serão fornecidos ou pagos pelo contratante.';
 const obs=$('cobs')?.value||'';
 const company=d.company||'RECOLL';
 const address=$('caddress')?.value||currentQuote.address||'';
 const city=$('ccity')?.value||currentQuote.city||'';
 return `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Contrato RECOLL</title><style>body{font-family:Arial,sans-serif;padding:24px;color:#111;line-height:1.45;font-size:12px}h1{text-align:center;font-size:22px}h2{font-size:15px;margin-top:20px;border-bottom:1px solid #ccc;padding-bottom:5px}.box{border:1px solid #ddd;padding:12px;border-radius:8px;white-space:pre-wrap}.sign{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:70px}.line{border-top:1px solid #111;padding-top:7px;text-align:center}.notice{background:#f4f6f8;padding:10px;border-radius:6px}@media print{body{padding:15mm}}</style></head><body><div style="display:flex;align-items:center;justify-content:flex-start;gap:12px;margin:0 0 18px;padding-bottom:10px;border-bottom:2px solid #1b58ce"><img src="data:image/png;base64," alt="Logo oficial RECOLL" style="display:block;width:76px;height:76px;object-fit:contain;flex:none"><div style="display:flex;flex-direction:column;justify-content:center;margin-left:12px"><strong style="font-size:24px;color:#1556c8">${esc(company)}</strong><span style="font-size:10px;font-weight:bold">REFORMA, CONSTRUÇÃO E LIMPEZA</span></div></div><h2>CONTRATO DE PRESTAÇÃO DE SERVIÇOS</h2><p><b>Nº do orçamento:</b> ${esc(currentQuote.number||'')}</p><p><b>Contratante:</b> ${esc(client)}</p><p><b>Endereço da obra:</b> ${esc(address)}</p><p><b>Cidade:</b> ${esc(city)}</p><h2>1. OBJETO DO CONTRATO</h2><div class="box">${esc(services)}</div><h2>2. VALOR CONTRATADO</h2><p><b>${esc(value)}</b></p><p class="notice">O valor refere-se exclusivamente à mão de obra. Materiais e produtos não estão incluídos e serão fornecidos ou pagos pelo contratante.</p><h2>3. PRAZO DE EXECUÇÃO</h2><p>${esc(deadline)}</p><h2>4. FORMA DE PAGAMENTO</h2><p>${esc(payment)}</p><h2>5. SERVIÇOS INCLUÍDOS</h2><p>${esc(included)}</p><h2>6. ITENS NÃO INCLUÍDOS</h2><p>${esc(excluded)}</p><h2>7. OBSERVAÇÕES E CONDIÇÕES</h2><p>${esc(obs)}</p><div class="sign"><div class="line">${esc(company)}<br>Contratada</div><div class="line">${esc(client||'Contratante')}<br>Contratante</div></div></body></html>`;
}
async function recollGenerateContractFile(){
 if(!currentQuote)throw new Error('Abra um orçamento primeiro.');
 if(!window.html2pdf){
  await new Promise((resolve,reject)=>{
   const script=document.createElement('script');
   script.src='https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
   script.onload=resolve;script.onerror=()=>reject(new Error('Não foi possível carregar o gerador de PDF. Confira a conexão.'));
   document.head.appendChild(script);
  });
 }
 const html=recollBuildContractHtml();
 const parsed=new DOMParser().parseFromString(html,'text/html');
 const host=document.createElement('div');
 const styleNode=document.createElement('style');
 styleNode.textContent=Array.from(parsed.querySelectorAll('style')).map(x=>x.textContent).join('\n');
 document.head.appendChild(styleNode);
 host.style.cssText='position:absolute;left:0;top:0;width:700px;min-height:990px;background:#fff;color:#111;overflow:visible;opacity:1;pointer-events:none;';
 const body=parsed.body.cloneNode(true);
 body.querySelectorAll('script').forEach(x=>x.remove());
 host.innerHTML='<div style="width:700px;min-height:990px;background:#fff;color:#111;font-family:Arial,sans-serif;font-size:12px;padding:0;box-sizing:border-box">'+body.innerHTML+'</div>';
 document.body.appendChild(host);
 try{
  await Promise.all(Array.from(host.querySelectorAll('img')).map(img=>img.decode?img.decode().catch(()=>{}):Promise.resolve()));
  await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
  const blob=await window.html2pdf().set({margin:[12,12,12,12],image:{type:'jpeg',quality:.98},html2canvas:{scale:2,useCORS:true,backgroundColor:'#ffffff',logging:false,scrollX:0,scrollY:0},jsPDF:{unit:'mm',format:'a4',orientation:'portrait'},pagebreak:{mode:['css','legacy']}}).from(host.firstElementChild).outputPdf('blob');
  if(!blob||blob.size<1000)throw new Error('O PDF foi gerado vazio.');
  const safe=String($('cclient')?.value||currentQuote.client||'Cliente').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9_-]+/g,'_').slice(0,40)||'Cliente';
  recollPendingContractFile=new File([blob],`Contrato_RECOLL_${safe}.pdf`,{type:'application/pdf'});
  return recollPendingContractFile;
 }finally{host.remove();styleNode.remove();}
}
function recollShowContractSharePanel(){
 let old=document.getElementById('recollContractSharePanel');if(old)old.remove();
 const panel=document.createElement('div');panel.id='recollContractSharePanel';
 panel.style.cssText='position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:20px;';
 panel.innerHTML='<div style="background:#fff;color:#222;border-radius:14px;padding:22px;max-width:360px;width:100%;font:16px Arial,sans-serif;box-shadow:0 8px 32px #0004"><h3 style="margin:0 0 10px;color:#17417e">Contrato pronto para enviar</h3><p style="line-height:1.45">O contrato foi gerado em PDF. Toque em compartilhar e escolha WhatsApp; não precisa baixar o arquivo manualmente.</p><button id="recollContractShareNow" style="width:100%;padding:14px;border:0;border-radius:8px;background:#1558d5;color:white;font-size:16px;font-weight:bold">📲 Compartilhar contrato</button><button id="recollContractDownload" style="width:100%;padding:12px;margin-top:8px;border:1px solid #bbb;border-radius:8px;background:white;color:#222;font-size:15px">Baixar PDF</button><button id="recollContractClose" style="width:100%;padding:10px;margin-top:4px;border:0;background:white;color:#555;font-size:14px">Fechar</button></div>';
 document.body.appendChild(panel);
 document.getElementById('recollContractShareNow').onclick=()=>shareContractWhatsApp();
 document.getElementById('recollContractDownload').onclick=()=>downloadRecollShareFile(recollPendingContractFile,recollPendingContractFile?.name||'Contrato_RECOLL.pdf');
 document.getElementById('recollContractClose').onclick=()=>panel.remove();
}
async function makeContractPDF(){
 try{await recollGenerateContractFile();recollShowContractSharePanel();}
 catch(e){console.error(e);alert(e.message||'Não foi possível gerar o contrato em PDF.');}
}
async function shareContractWhatsApp(){
 if(!currentQuote){alert('Abra um orçamento primeiro.');return}
 try{
  const file=recollPendingContractFile||await recollGenerateContractFile();
  const client=$('cclient')?.value||currentQuote.client||'';
  const text=`Olá, ${client}! Segue o contrato em PDF referente ao orçamento ${currentQuote.number||''} da RECOLL.`;
  if(navigator.share&&(!navigator.canShare||navigator.canShare({files:[file]}))){
   await navigator.share({title:'Contrato RECOLL',text,files:[file]});
   const panel=document.getElementById('recollContractSharePanel');if(panel)panel.remove();
  }else{
   downloadRecollShareFile(file,file.name);
   alert('Este navegador não permite anexar o PDF diretamente. O arquivo foi preparado; no WhatsApp, toque no clipe e escolha Documento.');
  }
 }catch(e){if(e&&e.name==='AbortError')return;console.error(e);alert(e.message||'Não foi possível compartilhar o contrato.');}
}
function renderQuotePhotos(){
 const el=$('quotePhotosPreview'); if(!el)return;
 el.innerHTML='';
 el.style.cssText='display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;align-items:start';
 recollQuotePhotos.forEach((src,i)=>{
  const wrap=document.createElement('div');wrap.style.cssText='width:100%;min-width:0;position:relative';
  const img=document.createElement('img');img.src=src;img.alt='Foto do serviço';img.style.cssText='display:block;width:100%;height:92px;object-fit:cover;border-radius:8px;border:1px solid #ccd5e3';
  const b=document.createElement('button');b.type='button';b.textContent='Remover';b.className='gray';b.style.cssText='font-size:12px;padding:5px;width:100%;margin-top:4px';b.onclick=()=>{recollQuotePhotos.splice(i,1);renderQuotePhotos();};
  wrap.appendChild(img);wrap.appendChild(b);el.appendChild(wrap);
 });
}
async function recollAddQuotePhotos(files){
 const arr=Array.from(files||[]);
 for(const file of arr){
  if(!file.type.startsWith('image/'))continue;
  if(recollQuotePhotos.length>=8){alert('O limite é de 8 fotos por orçamento.');break;}
  try{
   const data=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file);});
   // Reduzir as imagens para poupar espaço no armazenamento do celular.
   const img=await new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>resolve(im);im.onerror=reject;im.src=data;});
   const scale=Math.min(1,1200/Math.max(img.width,img.height));const canvas=document.createElement('canvas');
   canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));
   canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);
   recollQuotePhotos.push(canvas.toDataURL('image/jpeg',0.78));
  }catch(e){alert('Não foi possível carregar uma das fotos. Tente outra imagem.');}
 }
 const input=$('quotePhotosInput');if(input)input.value='';
 renderQuotePhotos();
}

function saveQuote(){
 if(!currentQuote){alert('Calcule o orçamento primeiro.');return}
 currentQuote.status=currentQuote.approved?'Aprovado':'Rascunho'; currentQuote.photos=recollQuotePhotos.slice();
 let h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');
 let idx=h.findIndex(x=>x.number===currentQuote.number);
 if(editingQuoteNumber && idx>=0){h[idx]=currentQuote;alert('Orçamento atualizado!');}
 else {h.unshift(currentQuote);alert('Orçamento salvo!');}
 localStorage.setItem('recoll_quotes',JSON.stringify(h));
 editingQuoteNumber=null;
}
function editQuote(number){
 let h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');
 let q=h.find(x=>x.number===number);
 if(!q){alert('Orçamento não encontrado.');return;}
 currentQuote=JSON.parse(JSON.stringify(q));
 recollQuotePhotos=Array.isArray(q.photos)?q.photos.slice():[]; renderQuotePhotos();
 editingQuoteNumber=number;
 $('client').value=q.client||''; $('phone').value=q.phone||''; $('city').value=q.city||$('city').options[0].value; $('kind').value=q.kind||$('kind').options[0].value; $('address').value=q.address||'';
 let serviceValue=(q.service||'').includes('Piso')?'floor':(q.service||'').includes('Limpeza')?'clean':(q.service||'').includes('Pintura')?'paint':(q.service||'').includes('Elétrica')?'electric':(q.service||'').includes('Hidráulica')?'hydraulic':(q.service||'').includes('Alvenaria')?'masonry':'other';
 $('service').value=serviceValue; fields();
 if(serviceValue==='floor'){
   let m=(q.desc||'').match(/([0-9]+(?:[.,][0-9]+)?)\s*m²/); if($('area'))$('area').value=m?m[1].replace(',','.'):'';
 } else if(serviceValue==='clean'){
   if(q.cleanData){$('pros').value=q.cleanData.pros;$('days').value=q.cleanData.days;$('pd').value=q.cleanData.pd;$('ud').value=q.cleanData.ud;$('fuel').value=q.cleanData.fuel;$('prod').value=q.cleanData.prod;$('othercost').value=q.cleanData.othercost;}
 } else if(q.genericData){if($('qty'))$('qty').value=q.genericData.qty||1;if($('base'))$('base').value=q.genericData.base||0;}
 $('obs').value=q.obs||'';
 quoteItems=JSON.parse(JSON.stringify(q.items||[])).map((x,i)=>({...x,id:++quoteItemCounter}));
 renderQuoteItems();
 $('result').innerHTML=`<div class="card"><div class="small">Editando orçamento ${q.number}</div><div class="total">${brl(q.total)}</div><p>Faça as alterações e toque em <b>Salvar alterações</b>.</p><button class="primary" onclick="calculate()">🔄 Recalcular</button><button class="green" onclick="saveQuote()">💾 Salvar alterações</button></div>`;
 show('new');
 window.scrollTo({top:0,behavior:'smooth'});
}

function renderHistory(){
 let h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]'),m=JSON.parse(localStorage.getItem('recoll_maint')||'[]');
 let quoteHtml=h.map(q=>`<div class="item"><div class="itemHead"><b>${q.number}</b><span class="tag">${q.approved?'Aprovado':(q.status||'Rascunho')}</span></div><br>${q.client||'Cliente'} — ${q.service||'Orçamento'}<br><b>${brl(q.total)}</b><br><span class="small">${q.date||''}</span><br>${!q.approved?`<button class="primary" onclick="editQuote('${q.number}')">✏️ Editar orçamento</button>`:`<button class="gray" onclick="editQuote('${q.number}')">👁️ Abrir orçamento</button>`}</div>`).join('');
 let maintHtml=m.map(q=>`<div class="item"><div class="itemHead"><b>${q.number}</b><span class="tag">Manutenção</span></div><br>${q.cond} — ${q.type}<br><b>${brl(q.total)}</b><br><span class="small">${q.date||''}</span></div>`).join('');
 $('history').innerHTML=(quoteHtml+maintHtml)||'Nenhum registro salvo nesta sessão.';
}

function defaultPrices(){let p=JSON.parse(localStorage.getItem('recoll_mprices')||'null');if(!p){p=[{name:'Troca de torneira',unit:'un.',price:120},{name:'Troca de lâmpada',unit:'un.',price:35},{name:'Pintura de parede',unit:'m²',price:35},{name:'Reparo de parede',unit:'m²',price:45},{name:'Limpeza de área comum',unit:'serviço',price:300},{name:'Hora de manutenção',unit:'hora',price:60}];localStorage.setItem('recoll_mprices',JSON.stringify(p));}return p;}
function renderPrices(){let p=defaultPrices();$('priceList').innerHTML=p.map((x,i)=>`<div class="item"><div class="itemHead"><b>${x.name}</b><button class="danger" onclick="removePrice(${i})">Excluir</button></div>${x.category?`<span class="tag">${x.category}</span> `:''}<span class="tag">${x.unit}</span> <span class="money">${brl(x.price)}</span><div class="small">Somente mão de obra · materiais por conta do cliente</div></div>`).join('')||'<p class="small">Nenhum serviço cadastrado.</p>';}
function togglePriceForm(showForm){const f=$('newPriceForm');if(!f)return;f.classList.toggle('hidden',showForm===false?true:showForm===true?false:!f.classList.contains('hidden'));if(!f.classList.contains('hidden')){$('newPriceName').focus();}}
function saveNewPrice(){const n=$('newPriceName').value.trim(),c=$('newPriceCategory').value,u=$('newPriceUnit').value,v=Number(String($('newPriceValue').value).replace(',','.'));if(!n){alert('Informe o nome do serviço.');$('newPriceName').focus();return;}if(!$('newPriceValue').value.trim()||!Number.isFinite(v)||v<0){alert('Informe um preço válido para a mão de obra.');$('newPriceValue').focus();return;}let p=defaultPrices();if(p.some(x=>x.name.trim().toLowerCase()===n.toLowerCase())){alert('Esse serviço já está cadastrado. Use outro nome ou edite o serviço existente.');return;}p.push({category:c,name:n,unit:u,price:v,laborOnly:true});localStorage.setItem('recoll_mprices',JSON.stringify(p));$('newPriceName').value='';$('newPriceValue').value='';togglePriceForm(false);renderPrices();if(typeof renderItems==='function')renderItems();alert('Serviço cadastrado na tabela RECOLL!');}
function addPrice(){togglePriceForm(true);}
function removePrice(i){let p=defaultPrices();p.splice(i,1);localStorage.setItem('recoll_mprices',JSON.stringify(p));renderPrices();if(typeof renderItems==='function')renderItems();}

function addItem(){let p=defaultPrices(),id=++itemCounter;items.push({id,name:'',unit:'un.',qty:1,price:0});renderItems();}
function renderItems(){let p=defaultPrices();$('items').innerHTML=items.map((it,i)=>`<div class="item">
<div class="itemHead"><b>Item ${i+1}</b><button class="danger" onclick="removeItem(${it.id})">Excluir</button></div>
<label>Serviço</label><select onchange="setItem(${it.id},'name',this.value);setItemFromPrice(${it.id},this.value)"><option value="">Selecione...</option>${p.map(x=>`<option ${it.name===x.name?'selected':''}>${x.name}</option>`).join('')}</select>
<div class="row"><div><label>Quantidade</label><input type="number" step="0.01" value="${it.qty}" onchange="setItem(${it.id},'qty',this.value)"></div><div><label>Unidade</label><input value="${it.unit}" onchange="setItem(${it.id},'unit',this.value)"></div></div>
<div class="row"><div><label>Preço unitário</label><input type="number" step="0.01" value="${it.price}" onchange="setItem(${it.id},'price',this.value)"></div><div><label>Total do item</label><input value="${brl(it.qty*it.price)}" readonly></div></div>
</div>`).join('');updateMTotal();}
function setItem(id,k,v){let it=items.find(x=>x.id===id);if(it){it[k]=k==='qty'||k==='price'?parseFloat(v)||0:v;updateMTotal();}}
function setItemFromPrice(id,name){let it=items.find(x=>x.id===id),p=defaultPrices().find(x=>x.name===name);if(it&&p){it.unit=p.unit;it.price=p.price;renderItems();}}
function removeItem(id){items=items.filter(x=>x.id!==id);renderItems();}
function updateMTotal(){let t=items.reduce((a,x)=>a+x.qty*x.price,0);$('mtotal').textContent=brl(t);return t;}

function saveMaintenance(){if(!items.length){alert('Adicione pelo menos um item.');return}let q={number:'MAN-'+Date.now().toString().slice(-6),cond:$('mcond').value||'Condomínio',resp:$('mresp').value,phone:$('mphone').value,type:$('mtype').value,desc:$('mdesc').value,items:JSON.parse(JSON.stringify(items)),total:updateMTotal(),date:new Date().toLocaleDateString('pt-BR')};let h=JSON.parse(localStorage.getItem('recoll_maint')||'[]');h.unshift(q);localStorage.setItem('recoll_maint',JSON.stringify(h));currentQuote=q;alert('Manutenção salva!');}
function makeMaintenancePDF(){ if(!items.length){alert('Adicione itens primeiro.');return;} updateMTotal(); alert('PDF de manutenção: use o botão PDF após salvar.'); }
</script>
<section class="card hidden" id="termoEntregaV14" style="margin-top:18px;">
<h2>📑 Termo de Entrega</h2>
<p>Registre formalmente a conclusão e a entrega da obra ao cliente.</p>
<label>📅 Data da entrega</label>
<input id="termoDataV14" type="date"/>
<label>👤 Cliente / responsável</label>
<input id="termoClienteV14" placeholder="Nome do cliente ou responsável" type="text"/>
<label>🏗️ Obra / endereço</label>
<input id="termoObraV14" placeholder="Identificação da obra" type="text"/>
<label>📝 Observações finais</label>
<textarea id="termoObsV14" placeholder="Observações sobre a entrega" rows="4"></textarea>
<div class="card">
<b>Declaração</b>
<p>
      Declaro que a obra/serviço acima identificado foi concluído e apresentado
      para conferência, ficando registradas neste termo as observações e
      pendências informadas na entrega.
    </p>
</div>
<div style="display:grid;gap:10px;">
<label>✍️ Assinatura do cliente
      <input id="termoAssClienteV14" placeholder="Nome / assinatura" type="text"/>
</label>
<label>✍️ Assinatura RECOLL
      <input id="termoAssRecollV14" placeholder="Nome / assinatura" type="text"/>
</label>
</div>
<button onclick="salvarTermoV14()" type="button">💾 Salvar termo</button>
<button onclick="imprimirTermoV14()" type="button">📄 Gerar termo para PDF</button>
</section>
<script>(function(){
function key(){return "recoll_termo_entrega_v14";}
window.salvarTermoV14=function(){var dados={data:document.getElementById("termoDataV14")?.value||"",cliente:document.getElementById("termoClienteV14")?.value||"",obra:document.getElementById("termoObraV14")?.value||"",obs:document.getElementById("termoObsV14")?.value||"",assCliente:document.getElementById("termoAssClienteV14")?.value||"",assRecoll:document.getElementById("termoAssRecollV14")?.value||""};localStorage.setItem(key(),JSON.stringify(dados));alert("Termo de entrega salvo com sucesso.");};
window.imprimirTermoV14=function(){alert("Termo de entrega pronto para impressão.");};
document.addEventListener("DOMContentLoaded",function(){try{var d=JSON.parse(localStorage.getItem(key())||"null");if(!d)return;var map={termoDataV14:d.data,termoClienteV14:d.cliente,termoObraV14:d.obra,termoObsV14:d.obs,termoAssClienteV14:d.assCliente,termoAssRecollV14:d.assRecoll};Object.keys(map).forEach(function(id){var e=document.getElementById(id);if(e)e.value=map[id]||"";});}catch(e){}});
})();</script>
<style>
  #recollAssinaturaOverlay{
    position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:9999;
    display:none;align-items:center;justify-content:center;padding:14px;
  }
  #recollAssinaturaBox{
    background:#fff;width:min(620px,100%);border-radius:18px;padding:18px;
    box-shadow:0 10px 40px rgba(0,0,0,.3);
  }
  #recollAssinaturaBox h2{margin:0 0 6px}
  #recollAssinaturaBox p{margin:4px 0 12px;color:#555}
  #recollCanvas{
    width:100%;height:230px;border:2px dashed #888;border-radius:12px;
    background:#fff;touch-action:none;display:block;
  }
  .recollAssBtn{
    border:0;border-radius:10px;padding:12px 16px;margin:10px 6px 0 0;
    font-weight:700;cursor:pointer;
  }
  .recollAssPrimary{background:#174ea6;color:#fff}
  .recollAssSecondary{background:#eee;color:#222}
  .recollAssStatus{font-size:13px;color:#16733a;margin-top:8px;min-height:18px}
</style>
<div id="recollAssinaturaOverlay">
<div id="recollAssinaturaBox">
<h2>✍️ Assinatura do cliente</h2>
<p>O cliente pode assinar diretamente na tela do celular.</p>
<canvas id="recollCanvas"></canvas>
<div>
<button class="recollAssBtn recollAssSecondary" onclick="recollLimparAssinatura()">Limpar</button>
<button class="recollAssBtn recollAssSecondary" onclick="recollFecharAssinatura()">Cancelar</button>
<button class="recollAssBtn recollAssPrimary" onclick="recollSalvarAssinatura()">Salvar assinatura</button>
</div>
<div class="recollAssStatus" id="recollAssStatus"></div>
</div>
</div>
<script>
(function(){
  let canvas, ctx, desenhando=false, temAssinatura=false;

  function preparar(){
    canvas=document.getElementById('recollCanvas');
    if(!canvas) return;
    ctx=canvas.getContext('2d');
    const escala=window.devicePixelRatio||1;
    const w=canvas.clientWidth, h=canvas.clientHeight;
    canvas.width=w*escala; canvas.height=h*escala;
    ctx.scale(escala,escala);
    ctx.lineWidth=2.2; ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.strokeStyle='#111';

    function pos(e){
      const r=canvas.getBoundingClientRect();
      const t=e.touches&&e.touches[0];
      return {x:(t?t.clientX:e.clientX)-r.left,y:(t?t.clientY:e.clientY)-r.top};
    }
    function iniciar(e){e.preventDefault();desenhando=true;temAssinatura=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);}
    function mover(e){if(!desenhando)return;e.preventDefault();const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();}
    function parar(){desenhando=false;ctx.closePath();}
    canvas.addEventListener('pointerdown',iniciar);
    canvas.addEventListener('pointermove',mover);
    canvas.addEventListener('pointerup',parar);
    canvas.addEventListener('pointerleave',parar);
  }

  window.recollAbrirAssinatura=function(){
    const o=document.getElementById('recollAssinaturaOverlay');
    if(o){o.style.display='flex';}
    setTimeout(function(){preparar();},30);
  };

  window.recollFecharAssinatura=function(){
    const o=document.getElementById('recollAssinaturaOverlay');
    if(o)o.style.display='none';
  };

  window.recollLimparAssinatura=function(){
    if(!canvas||!ctx)return;
    ctx.clearRect(0,0,canvas.width,canvas.height);
    temAssinatura=false;
    document.getElementById('recollAssStatus').textContent='';
  };

  window.recollSalvarAssinatura=function(){
    if(!temAssinatura){
      document.getElementById('recollAssStatus').textContent='Faça a assinatura antes de salvar.';
      return;
    }
    const img=canvas.toDataURL('image/png');
    localStorage.setItem('recoll_assinatura_cliente',img);
    document.getElementById('recollAssStatus').textContent='Assinatura salva nesta obra.';
    setTimeout(function(){recollFecharAssinatura();},700);
    window.recollAssinaturaCliente=img;
  };

  document.addEventListener('DOMContentLoaded',function(){
    const termo = document.body.innerText || '';
    // Adiciona um botão próximo ao termo somente se ainda não houver um botão de assinatura.
    const botoes=[...document.querySelectorAll('button')];
    const alvo=botoes.find(b=>/termo|entrega/i.test(b.textContent||''));
    if(alvo && !document.getElementById('recollBtnAssinar')){
      const b=document.createElement('button');
      b.id='recollBtnAssinar';
      b.className=alvo.className || 'btn';
      b.type='button';
      b.textContent='✍️ Assinar Termo no celular';
      b.onclick=recollAbrirAssinatura;
      alvo.parentNode.insertBefore(b,alvo.nextSibling);
    }
  });
})();
</script>
