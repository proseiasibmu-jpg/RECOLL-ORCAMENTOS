<div id="recollPendOverlay">
<div id="recollPendBox">
<h2 class="recollPendTitulo">📋 Pendências da obra</h2>
<p class="recollPendSub">Registre o que ainda precisa ser resolvido antes da entrega.</p>
<div class="recollPendForm">
<label class="recollPendFull">Descrição da pendência
        <textarea id="recollPendDescricao" placeholder="Ex.: Fazer retoque de pintura no quarto 2" rows="2"></textarea>
</label>
<label>Prazo
        <input id="recollPendPrazo" type="date"/>
</label>
<label>Responsável
        <input id="recollPendResponsavel" placeholder="Ex.: RECOLL / João" type="text"/>
</label>
<label>Status
        <select id="recollPendNovoStatus">
<option>Aguardando</option>
<option>Em andamento</option>
</select>
</label>
</div>
<button class="recollPendBtn recollPendPrimary" onclick="recollAdicionarPendencia()">➕ Adicionar pendência</button>
<div class="recollPendResumo">
<div class="recollPendBadge">Abertas: <span id="recollPendAbertas">0</span></div>
<div class="recollPendBadge">Concluídas: <span id="recollPendConcluidas">0</span></div>
</div>
<div class="recollPendLista" id="recollPendLista"></div>
<div class="recollPendStatus" id="recollPendStatus"></div>
<button class="recollPendBtn recollPendSecondary" onclick="recollFecharPendencias()">Fechar</button>
<button class="recollPendBtn recollPendPrimary" onclick="recollSalvarPendencias()">💾 Salvar pendências</button>
</div>
</div>
<script>
(function(){
  const chave='recoll_pendencias_obra';
  let pendencias=[];

  function carregar(){
    try{
      const salvo=localStorage.getItem(chave);
      pendencias=salvo?JSON.parse(salvo):[];
    }catch(e){pendencias=[];}
  }

  function render(){
    const lista=document.getElementById('recollPendLista');
    lista.innerHTML='';
    const abertas=pendencias.filter(x=>x.status!=='Concluída').length;
    const concluidas=pendencias.filter(x=>x.status==='Concluída').length;
    document.getElementById('recollPendAbertas').textContent=abertas;
    document.getElementById('recollPendConcluidas').textContent=concluidas;

    if(!pendencias.length){
      lista.innerHTML='<div class="recollPendItem">Nenhuma pendência cadastrada.</div>';
      return;
    }

    pendencias.forEach((x,i)=>{
      const div=document.createElement('div');
      div.className='recollPendItem'+(x.status==='Concluída'?' concluida':'');
      div.innerHTML=
        '<strong>'+x.descricao+'</strong>'+
        '<small>Prazo: '+(x.prazo||'—')+
        ' · Responsável: '+(x.responsavel||'—')+
        ' · Status: <b>'+x.status+'</b></small>'+
        '<div class="recollPendAcoes">'+
        (x.status!=='Concluída'?'<button class="recollPendConcluir" onclick="recollConcluirPendencia('+i+')">✅ Concluir</button>':'')+
        '<button class="recollPendExcluir" onclick="recollExcluirPendencia('+i+')">Excluir</button></div>';
      lista.appendChild(div);
    });
  }

  window.recollAdicionarPendencia=function(){
    const descricao=document.getElementById('recollPendDescricao').value.trim();
    const prazo=document.getElementById('recollPendPrazo').value;
    const responsavel=document.getElementById('recollPendResponsavel').value.trim();
    const status=document.getElementById('recollPendNovoStatus').value;
    if(!descricao){
      document.getElementById('recollPendStatus').textContent='Informe a descrição da pendência.';
      return;
    }
    pendencias.push({descricao,prazo,responsavel,status});
    document.getElementById('recollPendDescricao').value='';
    document.getElementById('recollPendPrazo').value='';
    document.getElementById('recollPendResponsavel').value='';
    document.getElementById('recollPendStatus').textContent='Pendência cadastrada.';
    render();
  };

  window.recollConcluirPendencia=function(i){
    pendencias[i].status='Concluída';
    render();
  };

  window.recollExcluirPendencia=function(i){
    pendencias.splice(i,1);
    render();
  };

  window.recollSalvarPendencias=function(){
    localStorage.setItem(chave,JSON.stringify(pendencias));
    document.getElementById('recollPendStatus').textContent='Pendências salvas nesta obra.';
  };

  window.recollAbrirPendencias=function(){
    carregar(); render();
    document.getElementById('recollPendOverlay').style.display='flex';
  };

  window.recollFecharPendencias=function(){
    document.getElementById('recollPendOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    const checklist=document.getElementById('recollBtnChecklist');
    if(checklist && !document.getElementById('recollBtnPendencias')){
      const b=document.createElement('button');
      b.id='recollBtnPendencias';
      b.type='button';
      b.textContent='📋 Pendências da obra';
      b.onclick=recollAbrirPendencias;
      b.style.cssText='background:#b35a00;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      checklist.parentNode.appendChild(b);
    }
  });
})();
</script>
