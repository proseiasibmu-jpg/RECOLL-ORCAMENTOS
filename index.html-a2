<button class="recollRelBtn recollRelPrimary" onclick="window.print()">🖨️ Gerar / imprimir PDF</button>
</div>
</div>
</div>
<script>
(function(){
  function procurar(padroes){
    const els=[...document.querySelectorAll('input,select,textarea')];
    for(const p of padroes){
      const el=els.find(e=>{
        const t=((e.id||'')+' '+(e.name||'')+' '+(e.placeholder||'')).toLowerCase();
        return t.includes(p);
      });
      if(el && String(el.value||'').trim()) return el.value.trim();
    }
    return '';
  }
  function moeda(v){
    return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  }
  function numero(v){
    let s=String(v||'').replace(/[^\d,.-]/g,'');
    if(s.includes(',')&&s.includes('.'))s=s.replace(/\./g,'').replace(',','.');
    else s=s.replace(',','.');
    return Number(s)||0;
  }
  function preencher(id,v){
    const e=document.getElementById(id);if(e)e.textContent=v||'—';
  }
  function fotos(id,arr){
    const box=document.querySelector('#'+id+' .recollRelFotos');
    if(!box)return;
    box.innerHTML='';
    (arr||[]).forEach(src=>{
      const img=document.createElement('img');img.src=src;box.appendChild(img);
    });
  }

  window.recollAbrirRelatorio=function(){
    preencher('relCliente',procurar(['cliente','nome']));
    preencher('relWhats',procurar(['whatsapp','telefone','celular']));
    preencher('relCidade',procurar(['cidade']));
    preencher('relEndereco',procurar(['endereço','endereco']));
    preencher('relServico',procurar(['serviço','servico']));
    preencher('relStatus',procurar(['status'])||'—');

    const contratado=numero(procurar(['valor contratado','valor total','total']));
    const recebido=numero(procurar(['recebido']));
    let ads=[],adTotal=0;
    try{
      ads=JSON.parse(localStorage.getItem('recoll_servicos_adicionais')||'[]');
      adTotal=ads.filter(x=>x.status==='Aprovado').reduce((s,x)=>s+Number(x.total||0),0);
    }catch(e){}
    preencher('relContratado',moeda(contratado));
    preencher('relAdicionais',moeda(adTotal));
    preencher('relTotal',moeda(contratado+adTotal));
    preencher('relRecebido',moeda(recebido));
    preencher('relSaldo',moeda(Math.max(0,contratado+adTotal-recebido)));

    const adBox=document.getElementById('relAdicionaisLista');
    if(!ads.length)adBox.textContent='Nenhum adicional registrado.';
    else{
      adBox.innerHTML='';
      const ul=document.createElement('ul');ul.className='recollRelLista';
      ads.forEach(x=>{
        const li=document.createElement('li');
        li.textContent=x.descricao+' — '+x.qtd+' '+x.unidade+' — '+moeda(x.total)+' — '+x.status;
        ul.appendChild(li);
      });
      adBox.appendChild(ul);
    }

    let ps=[];
    try{ps=JSON.parse(localStorage.getItem('recoll_pendencias_obra')||'[]')}catch(e){}
    const pBox=document.getElementById('relPendenciasLista');
    if(!ps.length)pBox.textContent='Nenhuma pendência registrada.';
    else{
      pBox.innerHTML='';
      const ul=document.createElement('ul');ul.className='recollRelLista';
      ps.forEach(x=>{
        const li=document.createElement('li');
        li.textContent=x.descricao+' — Prazo: '+(x.prazo||'—')+' — '+x.status;
        ul.appendChild(li);
      });
      pBox.appendChild(ul);
    }

    let ck={};
    try{ck=JSON.parse(localStorage.getItem('recoll_checklist_obra')||'{}')}catch(e){}
    const nomes={iniciada:'Obra iniciada',material:'Material conferido',execucao:'Execução concluída',limpeza:'Limpeza realizada',fotos:'Fotos finais registradas',pendencias:'Pendências verificadas',cliente:'Cliente vistoriou a obra',termo:'Termo assinado',entregue:'Obra entregue'};
    const feitos=Object.keys(nomes).filter(k=>ck[k]).length;
    preencher('relChecklist',feitos+' de '+Object.keys(nomes).length+' etapas concluídas');

    let f={antes:[],durante:[],depois:[]};
    try{f=Object.assign(f,JSON.parse(localStorage.getItem('recoll_fotos_obra')||'{}'))}catch(e){}
    fotos('relFotosAntes',f.antes);fotos('relFotosDurante',f.durante);fotos('relFotosDepois',f.depois);

    const ass=document.getElementById('relAssinatura');
    ass.innerHTML='';
    const assinatura=localStorage.getItem('recoll_assinatura_cliente');
    if(assinatura){
      const img=document.createElement('img');img.src=assinatura;img.alt='Assinatura do cliente';
      ass.appendChild(img);
      const linha=document.createElement('div');linha.textContent='Assinatura do cliente';ass.appendChild(linha);
    }else ass.textContent='Assinatura não registrada.';

    const hoje=new Date().toLocaleDateString('pt-BR');
    preencher('recollRelCliente', 'Cliente: '+(procurar(['cliente','nome'])||'—'));
    preencher('recollRelObra', 'Obra: '+(procurar(['endereço','endereco'])||'—'));
    preencher('recollRelData', 'Relatório emitido em: '+hoje);

    document.getElementById('recollRelOverlay').style.display='flex';
  };
  window.recollFecharRelatorio=function(){
    document.getElementById('recollRelOverlay').style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    const painel=document.getElementById('recollBtnPainel');
    if(painel && !document.getElementById('recollBtnRelatorio')){
      const b=document.createElement('button');
      b.id='recollBtnRelatorio';b.type='button';
      b.textContent='📄 Relatório completo';
      b.onclick=recollAbrirRelatorio;
      b.style.cssText='background:#174ea6;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700;font-size:16px;margin:0 0 18px 8px;';
      painel.parentNode.appendChild(b);
    }
  });
})();
</script>
<script>
(function(){
  function procurar(padroes){
    const els=[...document.querySelectorAll('input,select,textarea')];
    for(const p of padroes){
      const el=els.find(e=>{
        const t=((e.id||'')+' '+(e.name||'')+' '+(e.placeholder||'')).toLowerCase();
        return t.includes(p);
      });
      if(el && String(el.value||'').trim()) return el.value.trim();
    }
    return '';
  }
  function moeda(v){
    return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  }
  function numero(v){
    let s=String(v||'').replace(/[^\d,.-]/g,'');
    if(s.includes(',')&&s.includes('.'))s=s.replace(/\./g,'').replace(',','.');
    else s=s.replace(',','.');
    return Number(s)||0;
  }
  function textoWhatsApp(){
    const cliente=procurar(['cliente','nome'])||'Cliente';
    const endereco=procurar(['endereço','endereco'])||'';
    const cidade=procurar(['cidade'])||'';
    const servico=procurar(['serviço','servico'])||'';
    const status=procurar(['status'])||'';
    const contratado=numero(procurar(['valor contratado','valor total','total']));
    const recebido=numero(procurar(['recebido']));
    let adTotal=0, pend=0;
    try{
      const a=JSON.parse(localStorage.getItem('recoll_servicos_adicionais')||'[]');
      adTotal=a.filter(x=>x.status==='Aprovado').reduce((s,x)=>s+Number(x.total||0),0);
    }catch(e){}
    try{
      const p=JSON.parse(localStorage.getItem('recoll_pendencias_obra')||'[]');
      pend=p.filter(x=>x.status!=='Concluída').length;
    }catch(e){}
    const total=contratado+adTotal;
    const saldo=Math.max(0,total-recebido);

    return `*RECOLL – Relatório da Obra*%0A%0A`+
      `👤 *Cliente:* ${cliente}%0A`+
      `🏠 *Obra:* ${endereco}${cidade?' – '+cidade:''}%0A`+
      `🛠️ *Serviço:* ${servico}%0A`+
      `📌 *Status:* ${status||'—'}%0A%0A`+
      `💰 *Valor contratado:* ${moeda(contratado)}%0A`+
      `➕ *Adicionais aprovados:* ${moeda(adTotal)}%0A`+
      `💵 *Total atualizado:* ${moeda(total)}%0A`+
      `💳 *Recebido:* ${moeda(recebido)}%0A`+
      `📌 *Saldo a receber:* ${moeda(saldo)}%0A`+
      `📋 *Pendências abertas:* ${pend}%0A%0A`+
      `Relatório completo gerado pelo *RECOLL Orçamentos*.`;
  }

  window.recollCompartilharRelatorioWhatsApp=function(){
    const numero=procurar(['whatsapp','telefone','celular']).replace(/\D/g,'');
    let url='https://wa.me/';
    if(numero) url+=numero+'?text='+textoWhatsApp();
    else url+='?text='+textoWhatsApp();
    window.open(url,'_blank');
  };

  document.addEventListener('DOMContentLoaded',function(){
    const rel=document.getElementById('recollRelDocumento');
    if(rel && !document.getElementById('recollBtnWhatsRelatorio')){
      const b=document.createElement('button');
      b.id='recollBtnWhatsRelatorio';
      b.type='button';
      b.textContent='📲 Enviar pelo WhatsApp';
      b.onclick=recollCompartilharRelatorioWhatsApp;
      b.style.cssText='background:#16803a;color:#fff;border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer;margin:6px 6px 0 0;';
      const btns=document.querySelector('#recollRelBox .recollRelBtns');
      if(btns) btns.insertBefore(b,btns.firstChild);
    }
  });
})();
</script>
<!-- RECOLL V28 - AGENDA DA RECOLL -->
<style>
#recollAgendaBox{margin-top:18px}
#recollAgendaBox .agenda-card{background:#fff;border:1px solid #ddd;border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 2px 8px rgba(0,0,0,.06)}
#recollAgendaBox .agenda-title{font-weight:700;font-size:16px;margin-bottom:6px}
#recollAgendaBox .agenda-meta{font-size:13px;line-height:1.5}
#recollAgendaBox .agenda-ok{border-left:5px solid #16a34a}
#recollAgendaBox .agenda-soon{border-left:5px solid #eab308}
#recollAgendaBox .agenda-late{border-left:5px solid #dc2626}
#recollAgendaBox .agenda-empty{padding:12px;text-align:center;color:#666;background:#f7f7f7;border-radius:12px}
</style>
<script>
(function(){
  function esc(s){
    return String(s==null?'':s).replace(/[&<>"']/g,function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function dateObj(v){
    if(!v) return null;
    var d=new Date(v+'T00:00:00');
    return isNaN(d.getTime()) ? null : d;
  }
  function fmt(v){
    var d=dateObj(v);
    return d ? d.toLocaleDateString('pt-BR') : 'Não informado';
  }
  function daysUntil(v){
    var d=dateObj(v); if(!d) return null;
    var now=new Date(); now.setHours(0,0,0,0);
    return Math.ceil((d-now)/86400000);
  }

  function readWorks(){
    var result=[];
    try{
      Object.keys(localStorage).forEach(function(k){
        var raw=localStorage.getItem(k);
        if(!raw) return;
        try{
          var x=JSON.parse(raw);
          if(!x || typeof x!=='object') return;
          var text=JSON.stringify(x).toLowerCase();
          if(
            ('obra' in x)||('cliente' in x)||('client' in x)||
            ('endereco' in x)||('address' in x)||
            text.indexOf('em andamento')>=0 ||
            text.indexOf('programada')>=0
          ) result.push(x);
        }catch(e){}
      });
    }catch(e){}
    return result;
  }

  function find(v, names){
    for(var i=0;i<names.length;i++) if(v && v[names[i]]!=null && v[names[i]]!=='') return v[names[i]];
    return '';
  }

  function renderAgenda(){
    var old=document.getElementById('recollAgendaBox');
    if(old) old.remove();

    var anchor=[...document.querySelectorAll('h1,h2,h3,h4,button,a,div')].find(function(el){
      return (el.textContent||'').trim()==='📊 Painel da obra';
    });

    var box=document.createElement('div');
    box.id='recollAgendaBox';
    box.innerHTML='<div class="agenda-card"><div class="agenda-title">📅 Agenda da RECOLL</div><div class="agenda-meta">Organização rápida de obras, prazos e pendências.</div></div>';

    var works=readWorks();
    var items=[];
    works.forEach(function(w){
      var client=find(w,['cliente','client','nomeCliente']);
      var obra=find(w,['obra','nomeObra','titulo','servico','service']);
      var start=find(w,['dataInicio','inicio','startDate','data_inicio']);
      var finish=find(w,['previsaoTermino','dataTermino','fim','finishDate','data_fim']);
      if(start||finish||client||obra){
        items.push({client:client,obra:obra,start:start,finish:finish});
      }
    });

    if(!items.length){
      box.innerHTML += '<div class="agenda-empty">Nenhuma obra com datas cadastradas encontrada.</div>';
    }else{
      items.sort(function(a,b){
        var da=dateObj(a.start||a.finish), db=dateObj(b.start||b.finish);
        return (da?da.getTime():Infinity)-(db?db.getTime():Infinity);
      });
      items.forEach(function(it){
        var n=daysUntil(it.finish), cls='agenda-ok', status='Dentro do prazo';
        if(n!==null && n<0){cls='agenda-late';status='Prazo vencido';}
        else if(n!==null && n<=3){cls='agenda-soon';status='Prazo próximo';}
        box.innerHTML += '<div class="agenda-card '+cls+'">'+
          '<div class="agenda-title">🏗️ '+esc(it.obra||'Obra')+'</div>'+
          '<div class="agenda-meta"><b>Cliente:</b> '+esc(it.client||'Não informado')+
          '<br><b>Início:</b> '+fmt(it.start)+
          '<br><b>Previsão de término:</b> '+fmt(it.finish)+
          '<br><b>Status do prazo:</b> '+status+'</div></div>';
      });
    }

    if(anchor && anchor.parentNode){
      anchor.parentNode.insertBefore(box,anchor.nextSibling);
    }else{
      document.body.appendChild(box);
    }
  }

  function addAgendaButton(){
    var exists=[...document.querySelectorAll('button,a')].some(function(el){
      return (el.textContent||'').trim().indexOf('📅 Agenda da RECOLL')>=0;
    });
    if(exists) return;
    var candidates=[...document.querySelectorAll('button,a')];
    var ref=candidates.find(function(el){
      var t=(el.textContent||'').trim();
      return t.indexOf('📲 Enviar pelo WhatsApp')>=0 || t.indexOf('📄 Relatório completo')>=0;
    });
    if(!ref) return;
    var b=ref.cloneNode(true);
    b.textContent='📅 Agenda da RECOLL';
    b.onclick=function(){renderAgenda(); document.getElementById('recollAgendaBox')?.scrollIntoView({behavior:'smooth'});};
    ref.parentNode.insertBefore(b,ref.nextSibling);
  }

  document.addEventListener('DOMContentLoaded',function(){
    setTimeout(addAgendaButton,500);
  });
  window.recollRenderAgenda=renderAgenda;
})();
</script>
<!-- RECOLL V28 - CENTRAL DE CLIENTES -->
<style>
#recollClientesBox{margin-top:18px}
#recollClientesBox .cliente-card{background:#fff;border:1px solid #ddd;border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 2px 8px rgba(0,0,0,.06)}
#recollClientesBox .cliente-title{font-weight:700;font-size:17px;margin-bottom:7px}
#recollClientesBox .cliente-meta{font-size:13px;line-height:1.55}
#recollClientesBox input,#recollClientesBox select{width:100%;box-sizing:border-box;padding:10px;border:1px solid #ccc;border-radius:9px;margin:5px 0}
#recollClientesBox button{padding:10px 12px;border:0;border-radius:9px;margin:5px 4px 0 0;cursor:pointer}
#recollClientesBox .cliente-primary{background:#174ea6;color:#fff}
#recollClientesBox .cliente-secondary{background:#eee;color:#222}
#recollClientesBox .cliente-total{font-weight:700;margin-top:8px}
#recollClientesBox .cliente-empty{padding:12px;text-align:center;color:#666;background:#f7f7f7;border-radius:12px}
</style>
<script>
(function(){
  var KEY='recoll_clientes_v27';

  function esc(s){
    return String(s==null?'':s).replace(/[&<>"']/g,function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function money(v){
    var n=parseFloat(v)||0;
    return n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
  }
  function load(){
    try{return JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){return [];}
  }
  function save(a){localStorage.setItem(KEY,JSON.stringify(a));}
  function normalize(s){return String(s||'').trim().toLowerCase();}
  function readWorks(){
    var result=[];
    try{
      Object.keys(localStorage).forEach(function(k){
        if(k===KEY) return;
        var raw=localStorage.getItem(k); if(!raw) return;
        try{
          var x=JSON.parse(raw);
          if(!x || typeof x!=='object') return;
          var text=JSON.stringify(x).toLowerCase();
          if(('cliente' in x)||('client' in x)||('nomeCliente' in x)||
             text.indexOf('em andamento')>=0||text.indexOf('programada')>=0){
            result.push(x);
          }
        }catch(e){}
      });
    }catch(e){}
    return result;
  }
  function val(o,names){
    for(var i=0;i<names.length;i++) if(o && o[names[i]]!=null && o[names[i]]!=='') return o[names[i]];
    return '';
  }

  function addCliente(){
    var nome=document.getElementById('rcNomeCliente').value.trim();
    if(!nome){alert('Informe o nome do cliente.');return;}
    var arr=load();
    var exists=arr.some(function(c){return normalize(c.nome)===normalize(nome);});
    if(exists){alert('Esse cliente já está cadastrado.');return;}
    arr.push({
      id:Date.now(),
      nome:nome,
      whatsapp:document.getElementById('rcWhatsCliente').value.trim(),
      tipo:document.getElementById('rcTipoCliente').value,
      cidade:document.getElementById('rcCidadeCliente').value.trim(),
      endereco:document.getElementById('rcEnderecoCliente').value.trim()
    });
    save(arr);
    render();
  }

  function delCliente(id){
    if(!confirm('Excluir este cliente da Central de Clientes?')) return;
    save(load().filter(function(c){return c.id!==id;}));
    render();
  }

  function wa(phone){
    var p=String(phone||'').replace(/\D/g,'');
    if(p && p.length>=10) window.open('https://wa.me/55'+p,'_blank');
  }

  function render(){
    var box=document.getElementById('recollClientesBox');
    if(!box) return;
    var clientes=load();
    var works=readWorks();

    var html='<div class="cliente-card"><div class="cliente-title">👥 Central de Clientes</div>'+
      '<div class="cliente-meta">Cadastre uma vez e consulte os dados e obras do cliente.</div>'+
      '<input id="rcNomeCliente" placeholder="Nome do cliente">'+
      '<input id="rcWhatsCliente" placeholder="WhatsApp">'+
      '<select id="rcTipoCliente"><option>Particular</option><option>Construtora</option><option>Condomínio</option></select>'+
      '<input id="rcCidadeCliente" placeholder="Cidade">'+
      '<input id="rcEnderecoCliente" placeholder="Endereço">'+
      '<button class="cliente-primary" onclick="recollAddCliente()">➕ Cadastrar cliente</button></div>';

    if(!clientes.length){
      html+='<div class="cliente-empty">Nenhum cliente cadastrado ainda.</div>';
    }

    clientes.forEach(function(c){
      var cw=works.filter(function(w){
        var wn=val(w,['cliente','client','nomeCliente']);
        return normalize(wn)===normalize(c.nome);
      });
      var contratado=0, recebido=0;
      cw.forEach(function(w){
        contratado += parseFloat(val(w,['valorContratado','contratado','valor','total']))||0;
        recebido += parseFloat(val(w,['valorRecebido','recebido']))||0;
      });
      html+='<div class="cliente-card">'+
        '<div class="cliente-title">👤 '+esc(c.nome)+'</div>'+
        '<div class="cliente-meta"><b>WhatsApp:</b> '+esc(c.whatsapp||'Não informado')+
        '<br><b>Tipo:</b> '+esc(c.tipo||'Não informado')+
        '<br><b>Cidade:</b> '+esc(c.cidade||'Não informada')+
        '<br><b>Endereço:</b> '+esc(c.endereco||'Não informado')+
        '<br><b>Obras encontradas:</b> '+cw.length+
        '<div class="cliente-total">💰 Contratado: '+money(contratado)+
        '<br>💵 Recebido: '+money(recebido)+
        '<br>📌 Saldo: '+money(contratado-recebido)+'</div></div>'+
        (c.whatsapp?'<button class="cliente-primary" onclick="recollClienteWA('+JSON.stringify(c.whatsapp)+')">📲 WhatsApp</button>':'')+
        '<button class="cliente-secondary" onclick="recollDeleteCliente('+c.id+')">🗑️ Excluir</button>'+
        '</div>';
    });
    box.innerHTML=html;
  }

  window.recollAddCliente=addCliente;
  window.recollDeleteCliente=delCliente;
  window.recollClienteWA=wa;

  function addButton(){
    var existing=[...document.querySelectorAll('button,a')].find(function(el){
      return (el.textContent||'').trim().indexOf('👥 Central de Clientes')>=0;
    });
    if(existing) return;
    var refs=[...document.querySelectorAll('button,a')];
    var ref=refs.find(function(el){
      var t=(el.textContent||'').trim();
      return t.indexOf('📅 Agenda da RECOLL')>=0 || t.indexOf('📂 Ficha completa da obra')>=0;
    });
    if(!ref) return;
    var b=ref.cloneNode(true);
    b.textContent='👥 Central de Clientes';
    b.onclick=function(){
      var old=document.getElementById('recollClientesBox');
      if(old){old.scrollIntoView({behavior:'smooth'});return;}
      var box=document.createElement('div');
      box.id='recollClientesBox';
      document.body.appendChild(box);
      render();
      box.scrollIntoView({behavior:'smooth'});
    };
    ref.parentNode.insertBefore(b,ref.nextSibling);
  }

  document.addEventListener('DOMContentLoaded',function(){
    setTimeout(addButton,600);
  });
})();
</script>
<style>
#rcmOverlay{display:none;position:fixed;z-index:999999;inset:0;background:rgba(0,0,0,.55);padding:16px;overflow:auto}
#rcmPanel{background:#fff;max-width:520px;margin:25px auto;border-radius:16px;padding:18px}
.rcmBtn{display:block;width:100%;box-sizing:border-box;border:0;border-radius:10px;padding:14px;margin:8px 0;background:#174ea6;color:#fff;font-size:16px;font-weight:700}
.rcmBack{background:#eee;color:#222}
.rcmRow{padding:10px 0;border-bottom:1px solid #eee}
.rcmInput{width:43%;box-sizing:border-box;padding:9px;border:1px solid #ccc;border-radius:8px;margin-top:6px}
</style>
<div id="rcmOverlay">
<div id="rcmPanel"></div>
</div>
<script>
(function(){
 const MODELOS = {
  "Limpeza pós-obra":[["Limpeza geral pós-obra","serviço"],["Limpeza de pisos","m²"],["Limpeza de revestimentos","m²"],["Limpeza de banheiros","un."]],
  "Pisos e revestimentos":[["Assentamento de piso","m²"],["Assentamento de revestimento","m²"],["Rodapé","m"],["Rejuntamento","m²"]],
  "Pintura":[["Preparação de paredes","m²"],["Pintura de paredes","m²"],["Pintura de tetos","m²"],["Pintura de portas","un."]],
  "Manutenção":[["Hora de manutenção","hora"],["Reparo de parede","m²"],["Troca de torneira","un."],["Troca de lâmpada","un."]],
  "Elétrica":[["Tomada/interruptor","un."],["Instalação de luminária","un."],["Reparo elétrico","serviço"]],
  "Hidráulica":[["Troca de torneira","un."],["Troca de sifão","un."],["Reparo de vazamento","serviço"]],
  "Outros serviços":[["Serviço geral","serviço"],["Mão de obra","dia"],["Serviço personalizado","serviço"]]
 };

 function painel(){return document.getElementById("rcmPanel")}
 function abrirModelos(){
  let h='<h2>📝 Modelos de Orçamento</h2><p>Escolha um modelo:</p>';
  Object.keys(MODELOS).forEach(function(nome){
   h+='<button type="button" class="rcmBtn" data-modelo="'+nome+'">📋 '+nome+'</button>';
  });
  h+='<button type="button" class="rcmBtn rcmBack" data-fechar>Fechar</button>';
  painel().innerHTML=h;
  document.getElementById("rcmOverlay").style.display="block";
 }
 function abrirModelo(nome){
  const itens=MODELOS[nome];
  let h='<h2>📋 '+nome+'</h2><p>Preencha os itens necessários:</p>';
  itens.forEach(function(it,i){
   h+='<div class="rcmRow"><b>'+it[0]+'</b><br><small>Unidade: '+it[1]+'</small><br>'+
      '<input class="rcmInput" id="rcq_'+i+'" type="number" min="0" step="0.01" placeholder="Quantidade">'+
      '<input class="rcmInput" id="rcp_'+i+'" type="number" min="0" step="0.01" placeholder="Preço"></div>';
  });
  h+='<button type="button" class="rcmBtn" data-salvar="'+nome+'">💾 Usar este modelo</button>'+
     '<button type="button" class="rcmBtn rcmBack" data-voltar>⬅️ Voltar</button>';
  painel().innerHTML=h;
 }
 function salvar(nome){
  const itens=MODELOS[nome], selecionados=[];
  itens.forEach(function(it,i){
   const q=parseFloat(document.getElementById("rcq_"+i).value)||0;
   const p=parseFloat(document.getElementById("rcp_"+i).value)||0;
   if(q||p) selecionados.push({descricao:it[0],unidade:it[1],quantidade:q,preco:p,total:q*p});
  });
  if(!selecionados.length){alert("Informe pelo menos um item.");return}
  localStorage.setItem("recoll_modelo_orcamento_atual",JSON.stringify({modelo:nome,itens:selecionados}));
  alert("Modelo salvo com sucesso.");
 }
 document.addEventListener("click",function(e){
  const b=e.target.closest("[data-modelo]");
  if(b){abrirModelo(b.getAttribute("data-modelo"));return}
  if(e.target.closest("[data-fechar]")){document.getElementById("rcmOverlay").style.display="none";return}
  const s=e.target.closest("[data-salvar]");
  if(s){salvar(s.getAttribute("data-salvar"));return}
  if(e.target.closest("[data-voltar]")){abrirModelos();return}
 });
 window.recollAbrirModelos=abrirModelos;

 document.addEventListener("DOMContentLoaded",function(){
  /* V40: botão de modelos agora existe somente na Home. */
});

})();</script>
