<strong>💵 Recebido</strong><span id="fichaRecebido">—</span>
</div>
</div>
<button class="recollFichaBtn recollFichaSecondary" onclick="recollFecharFichaObra()">Fechar</button>
<button class="recollFichaBtn recollFichaPrimary" onclick="window.print()">🖨️ Imprimir ficha</button>
</div>
</div>
<script>
(function(){
  function valor(id){
    const el=document.getElementById(id);
    return el ? (el.value || el.textContent || '').trim() : '';
  }
  function procurarValor(padroes){
    const els=[...document.querySelectorAll('input,select,textarea')];
    for(const p of padroes){
      const el=els.find(e=>{
        const t=((e.id||'')+' '+(e.name||'')+' '+(e.placeholder||'')+' '+(e.closest('label')?.textContent||'')).toLowerCase();
        return t.includes(p);
      });
      if(el && (el.value||'').trim()) return el.value.trim();
    }
    return '';
  }
  function textoPrimeiro(padroes){
    const els=[...document.querySelectorAll('body *')];
    for(const p of padroes){
      const el=els.find(e=>{
        if(e.children.length>0) return false;
        return (e.textContent||'').toLowerCase().includes(p);
      });
      if(el && el.textContent.trim()) return el.textContent.trim();
    }
    return '';
  }
  window.recollAbrirFichaObra=function(){
    const dados={
      cliente: procurarValor(['cliente','nome']),
      whatsapp: procurarValor(['whatsapp','telefone','celular']),
      tipo: procurarValor(['particular','construtora','condomínio','tipo']),
      cidade: procurarValor(['cidade']),
      endereco: procurarValor(['endereço','endereco','logradouro']),
      servico: procurarValor(['serviço','servico']),
      status: procurarValor(['status']) || textoPrimeiro(['programada','em andamento','concluída','entregue']),
      obs: procurarValor(['observação','observacoes','descrição','descricao']),
      valor: procurarValor(['valor contratado','valor total','total']),
      recebido: procurarValor(['recebido'])
    };
    const mapa={
      fichaCliente:dados.cliente,fichaWhatsApp:dados.whatsapp,fichaTipo:dados.tipo,
      fichaCidade:dados.cidade,fichaEndereco:dados.endereco,fichaServico:dados.servico,
      fichaStatus:dados.status,fichaObs:dados.obs,fichaValor:dados.valor,fichaRecebido:dados.recebido
    };
    Object.entries(mapa).forEach(([id,v])=>{
      const el=document.getElementById(id);
      if(el) el.textContent=v||'—';
    });
    const o=document.getElementById('recollFichaOverlay');
    if(o)o.style.display='flex';
  };
  window.recollFecharFichaObra=function(){
    const o=document.getElementById('recollFichaOverlay');
    if(o)o.style.display='none';
  };

  document.addEventListener('DOMContentLoaded',function(){
    /* A Ficha da Obra já possui cartão próprio na tela inicial.
       Não inserir um segundo botão automaticamente. */
  });
})();
</script>
