    background:#fff;
  }
  .recollAdItem strong{display:block}
  .recollAdItem small{color:#666}
  .recollAdAcoes button{
    border:0;border-radius:8px;padding:7px 10px;margin:8px 6px 0 0;font-weight:700;
  }
