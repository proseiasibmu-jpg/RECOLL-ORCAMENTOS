<style id="recollV41Buttons">
#recollHubOverlay{display:none;position:fixed;inset:0;z-index:999998;background:rgba(10,25,55,.58);padding:14px;overflow:auto}
#recollHubPanel{max-width:620px;margin:18px auto 30px;background:#fff;border-radius:20px;box-shadow:0 12px 45px #0005;overflow:hidden}
.rhHead{display:flex;align-items:center;gap:10px;padding:14px 16px;background:#f7f9fd;border-bottom:1px solid #e5e9f0;position:sticky;top:0;z-index:2}
.rhBack{border:0!important;background:#e8edf5!important;color:#172033!important;font-size:25px!important;width:44px;height:44px;padding:0!important;margin:0!important}
.rhTitle{font-size:22px;font-weight:900;color:#123c91}
.rhBody{padding:16px}.rhNew{width:100%;background:#1457d9;color:#fff;border:0;border-radius:13px;padding:14px;font-size:16px;font-weight:800;margin:0 0 14px}
.rhCard{background:#f8faff;border:1px solid #e1e7f0;border-radius:15px;padding:13px;margin:10px 0}
.rhCardHead{display:flex;justify-content:space-between;gap:8px;align-items:center}.rhName{font-weight:900;font-size:17px;color:#172033}.rhMeta{font-size:12px;color:#667085;margin-top:5px}.rhValue{font-size:18px;font-weight:900;color:#123c91;margin-top:7px}.rhActions{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}.rhActions button{margin:0!important;padding:9px 11px!important;border-radius:9px!important;font-size:12px!important}.rhBlue{background:#1457d9;color:#fff}.rhGreen{background:#159447;color:#fff}.rhGray{background:#e8edf5;color:#172033}.rhOrange{background:#f47b20;color:#fff}.rhDanger{background:#fee;color:#a22}.rhEmpty{text-align:center;color:#667085;padding:24px 8px}
#recollOtherService{margin:5px 0 9px}
</style>
<div id="recollHubOverlay"><div id="recollHubPanel"></div></div>
<script id="recollV41ButtonsScript">
(function(){
 const $=id=>document.getElementById(id);
 function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
 function closeHub(){ $('recollHubOverlay').style.display='none'; }
 function openHub(title,body){ $('recollHubPanel').innerHTML='<div class="rhHead"><button class="rhBack" type="button" onclick="recollHubClose()">‹</button><div class="rhTitle">'+title+'</div></div><div class="rhBody">'+body+'</div>'; $('recollHubOverlay').style.display='block'; window.scrollTo(0,0); }
 window.recollHubClose=closeHub;
 window.recollOpenVistorias=function(){renderVistorias();};
 window.recollOpenOrcamentos=function(){renderOrcamentos();};
 function resetInspection(){['vclient','vphone','vcity','vaddress','vproperty','vobs'].forEach(id=>{if($(id))$(id).value='';});if($('vphotos'))$('vphotos').value='';}
 function newInspection(){closeHub();show('inspection');resetInspection();window.scrollTo({top:0,behavior:'smooth'});}
 function newQuote(){closeHub();show('new');editingQuoteNumber=null;currentQuote=null;recollQuotePhotos=[];renderQuotePhotos();quoteItems=[];quoteItemCounter=0;sinapiSelectedCategories=[];sinapiSelectedServices=[];['client','phone','address','obs','sinapiCity'].forEach(id=>{if($(id))$(id).value='';});if($('city'))$('city').selectedIndex=0;if($('kind'))$('kind').selectedIndex=0;if($('service'))$('service').value='floor';if(typeof fields==='function')fields();if($('quoteItems'))$('quoteItems').innerHTML='';if($('result'))$('result').innerHTML='';window.scrollTo({top:0,behavior:'smooth'});}
 window.recollNewInspection=newInspection;window.recollNewQuote=newQuote;
 function renderVistorias(){
  const h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');
  let body='<button class="rhNew" type="button" onclick="recollNewInspection()">＋ Nova Vistoria</button>';
  if(!h.length) body+='<div class="rhEmpty">Nenhuma vistoria salva ainda.</div>';
  h.forEach((v,i)=>{body+='<div class="rhCard"><div class="rhCardHead"><div class="rhName">📸 '+esc(v.client||('Vistoria '+(i+1)))+'</div><span class="tag">Vistoria</span></div><div class="rhMeta">'+esc(v.date||'')+' • '+esc(v.city||'')+'</div><div class="rhMeta">'+esc(v.address||'')+'</div><div class="rhActions"><button class="rhBlue" onclick="recollEditVistoria('+i+')">✏️ Editar</button><button class="rhGray" onclick="recollVistoriaPDF('+i+')">📄 PDF</button><button class="rhGreen" onclick="recollVistoriaWhatsApp('+i+')">📲 WhatsApp</button><button class="rhOrange" onclick="recollVistoriaToQuote('+i+')">➡️ Orçamento</button></div></div>';});
  openHub('Vistorias',body);
 }
 function renderOrcamentos(){
  const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');
  let body='<button class="rhNew" type="button" onclick="recollNewQuote()">＋ Novo Orçamento</button>';
  if(!h.length) body+='<div class="rhEmpty">Nenhum orçamento salvo ainda.</div>';
  h.forEach((q,i)=>{let status=q.approved?'Aprovado':(q.status||'Rascunho');let acts='<button class="rhBlue" onclick="recollEditQuoteIndex('+i+')">✏️ Editar</button><button class="rhGray" onclick="recollQuotePDFIndex('+i+')">📄 PDF</button><button class="rhGreen" onclick="recollQuoteWhatsAppIndex('+i+')">📲 WhatsApp</button><button class="rhOrange" onclick="recollDeleteQuoteIndex('+i+')">🗑️ Excluir</button>';if(q.approved)acts+='<button class="rhOrange" onclick="recollQuoteContractIndex('+i+')">📑 Contrato</button><button class="rhBlue" onclick="recollStartWorkIndex('+i+')">🏗️ Iniciar obra</button>';body+='<div class="rhCard"><div class="rhCardHead"><div class="rhName">💰 '+esc(q.client||'Orçamento')+'</div><span class="tag">'+esc(status)+'</span></div><div class="rhMeta">'+esc(q.number||'')+' • '+esc(q.date||'')+'</div><div class="rhMeta">'+esc(q.service||'')+'</div><div class="rhValue">'+brl(q.total)+'</div><div class="rhActions">'+acts+'</div></div>';});
  openHub('Orçamentos',body);
 }
 window.recollDeleteQuoteIndex=function(i){
  const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');
  if(!h[i])return;
  const nome=h[i].client||h[i].number||'este orçamento';
  if(!confirm('Deseja realmente excluir o orçamento de '+nome+'? Esta ação não pode ser desfeita.'))return;
  h.splice(i,1);
  localStorage.setItem('recoll_quotes',JSON.stringify(h));
  renderOrcamentos();
 };
 window.recollEditQuoteIndex=function(i){const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');if(!h[i])return;closeHub();editQuote(h[i].number);};
 window.recollQuotePDFIndex=function(i){const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');if(!h[i])return;currentQuote=JSON.parse(JSON.stringify(h[i]));makePDF();};
 window.recollQuoteWhatsAppIndex=function(i){const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');if(!h[i])return;currentQuote=JSON.parse(JSON.stringify(h[i]));shareWhatsApp();};
 window.recollQuoteContractIndex=function(i){const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');if(!h[i])return;currentQuote=JSON.parse(JSON.stringify(h[i]));closeHub();openContractFromQuote();};
 window.recollStartWorkIndex=function(i){const h=JSON.parse(localStorage.getItem('recoll_quotes')||'[]');if(!h[i])return;h[i].inProgress=true;h[i].status='Em andamento';localStorage.setItem('recoll_quotes',JSON.stringify(h));alert('Obra iniciada e enviada para Minhas Obras.');renderOrcamentos();};
 window.recollEditVistoria=function(i){const h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');const v=h[i];if(!v)return;closeHub();show('inspection');$('vclient').value=v.client||'';$('vphone').value=v.phone||'';$('vcity').value=v.city||'';$('vaddress').value=v.address||'';$('vproperty').value=v.property||'';$('vobs').value=v.obs||'';window._recollEditingInspection=i;};
 function photoData(files){return Promise.all([...files].map(f=>new Promise(res=>{const r=new FileReader();r.onload=()=>res({name:f.name,data:r.result});r.readAsDataURL(f);})));}
 window.saveInspectionV4=async function(){const files=$('vphotos')?.files||[];const old=(JSON.parse(localStorage.getItem('recoll_inspections')||'[]'))[window._recollEditingInspection];const photos=files.length?await photoData(files):(old?.photos||[]);const v={client:$('vclient').value.trim(),phone:$('vphone').value.trim(),city:$('vcity').value.trim(),kind:$('vkind').value, address:$('vaddress').value.trim(),property:$('vproperty').value.trim(),obs:$('vobs').value.trim(),photos,date:old?.date||new Date().toLocaleDateString('pt-BR'),number:old?.number||('VST-'+Date.now().toString().slice(-6))};let h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');if(Number.isInteger(window._recollEditingInspection)){h[window._recollEditingInspection]=v;}else h.unshift(v);localStorage.setItem('recoll_inspections',JSON.stringify(h));window._recollEditingInspection=null;alert('Vistoria salva no aplicativo.');renderVistorias();};
 window.recollVistoriaPDF=function(i){const h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');const v=h[i];if(!v)return;const photos=(v.photos||[]).map(p=>'<img src="'+p.data+'" style="max-width:45%;max-height:220px;object-fit:contain;margin:6px;border:1px solid #ddd">').join('');const w=window.open('','_blank');w.document.write('<html><head><title>Vistoria '+esc(v.number)+'</title><style>body{font-family:Arial;padding:28px;color:#172033}h1{color:#123c91}h2{border-bottom:2px solid #1457d9;padding-bottom:5px}.box{padding:10px;border:1px solid #ddd;border-radius:10px;margin:8px 0}.photos{display:flex;flex-wrap:wrap}</style></head><body><h1>RECOLL</h1><h2>VISTORIA</h2><div class="box"><b>Cliente:</b> '+esc(v.client)+'<br><b>WhatsApp:</b> '+esc(v.phone)+'<br><b>Cidade:</b> '+esc(v.city)+'<br><b>Endereço:</b> '+esc(v.address)+'<br><b>Tipo de imóvel:</b> '+esc(v.property)+'<br><b>Data:</b> '+esc(v.date)+'</div><div class="box"><b>Observações</b><p>'+esc(v.obs).replace(/\n/g,'<br>')+'</p></div><div class="photos">'+photos+'</div><p style="margin-top:30px">RECOLL — reforma, construção e limpeza</p><scr'+'ipt>window.onload=function(){window.print();}<\/script></body></html>');w.document.close();};
 window.recollVistoriaWhatsApp=function(i){const h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');const v=h[i];if(!v)return;const msg='RECOLL — VISTORIA%0A%0ACliente: '+encodeURIComponent(v.client||'')+'%0AData: '+encodeURIComponent(v.date||'')+'%0ACidade: '+encodeURIComponent(v.city||'')+'%0AEndereço: '+encodeURIComponent(v.address||'')+'%0A%0AObservações:%0A'+encodeURIComponent(v.obs||'');window.open('https://wa.me/?text='+msg,'_blank');};
 window.recollVistoriaToQuote=function(i){const h=JSON.parse(localStorage.getItem('recoll_inspections')||'[]');const v=h[i];if(!v)return;newQuote();$('client').value=v.client||'';$('phone').value=v.phone||'';$('address').value=v.address||'';if($('city')){let opts=[...$('city').options];let found=opts.find(o=>o.text===v.city);if(found)$('city').value=found.value;}if($('obs'))$('obs').value=v.obs||'';};
 window.inspectionToQuoteV4=function(){window.recollVistoriaToQuote(0);};
 function patchHome(){const grid=$('r39Grid');if(!grid)return;const cards=grid.querySelectorAll('.r39card');if(cards[0]){cards[0].querySelector('strong').textContent='VISTORIA';cards[0].querySelector('small').textContent='Vistorias salvas';cards[0].onclick=()=>recollOpenVistorias();}if(cards[1]){cards[1].querySelector('strong').textContent='ORÇAMENTO';cards[1].querySelector('small').textContent='Orçamentos salvos';cards[1].onclick=()=>recollOpenOrcamentos();}}
 function patchOtherService(){const sel=$('service');if(!sel)return;const opt=[...sel.options].find(o=>o.value==='other');if(opt)opt.textContent='Outro serviço';const old=window.fields;window.fields=function(){old();if(sel.value==='other'){const d=$('dynamic');d.innerHTML='<label>Nome do serviço</label><input id="otherService" placeholder="Digite o serviço que deseja orçar"><div class="row"><div><label>Quantidade</label><input id="qty" type="number" value="1" step="0.01"></div><div><label>Preço base</label><input id="base" type="number" value="0" step="0.01"></div></div>';}};window.fields();const calc=window.calculate;window.calculate=function(){if(sel.value==='other'&&$('otherService')&&$('otherService').value.trim()){$('service').querySelector('option[value="other"]').textContent=$('otherService').value.trim();}calc();};}
 document.addEventListener('DOMContentLoaded',function(){setTimeout(function(){patchHome();patchOtherService();},50);});
})();
</script>
<script id="recollHomeButtonsFix20261006">
(function(){
  function ligarBotoesHome(){
    var grid=document.getElementById('r39Grid');
    if(!grid)return;
    var cards=grid.querySelectorAll('.r39card');
    var a=[
      function(){
        if(typeof window.recollOpenVistorias==='function') window.recollOpenVistorias();
        else if(typeof window.show==='function') window.show('inspection');
      },
      function(){
        if(typeof window.recollOpenOrcamentos==='function') window.recollOpenOrcamentos();
        else if(typeof window.show==='function') window.show('new');
      },
      function(){
        if(typeof window.show==='function') window.show('maintenance');
      },
      function(){
        if(window.currentQuote){
          if(typeof window.openContractFromQuote==='function') window.openContractFromQuote();
        }else if(typeof window.recollOpenOrcamentos==='function'){
          window.recollOpenOrcamentos();
        }else if(typeof window.show==='function'){
          window.show('contract');
        }
      },
      function(){
        if(typeof window.show==='function') window.show('works');
      },
      function(){
        if(typeof window.recollAbrirFichaObra==='function') window.recollAbrirFichaObra();
        else if(typeof window.show==='function') window.show('obras-v9');
      },
      function(){
        if(typeof window.recollAbrirCalculadora==='function') window.recollAbrirCalculadora();
        else if(typeof window.show==='function') window.show('calculadoraPrecos');
      },
      function(){
        if(typeof window.recollAbrirAssistente==='function') window.recollAbrirAssistente();
        else if(typeof window.show==='function') window.show('assistenteOrcamento');
      }
    ];
    cards.forEach(function(card,i){
      if(!a[i])return;
      card.onclick=function(e){
        if(e){e.preventDefault();e.stopPropagation();}
        a[i]();
      };
    });
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',ligarBotoesHome);
  }else{
    ligarBotoesHome();
  }
})();
</script>
<script id="recollCalcAssistantFix20261008">

(function(){
  function panel(title, html){
    var overlay=document.getElementById('recollHubOverlay');
    var box=document.getElementById('recollHubPanel');
    if(!overlay||!box){
      overlay=document.createElement('div'); overlay.id='recollHubOverlay';
      overlay.style.cssText='display:none;position:fixed;inset:0;z-index:999999;background:rgba(10,25,55,.58);padding:14px;overflow:auto';
      box=document.createElement('div');box.id='recollHubPanel';box.style.cssText='max-width:620px;margin:18px auto;background:#fff;border-radius:18px;overflow:hidden;font-family:Arial,sans-serif';overlay.appendChild(box);document.body.appendChild(overlay);
    }
    box.innerHTML='<div style="display:flex;align-items:center;gap:12px;padding:15px;background:#f4f7fc;border-bottom:1px solid #ddd"><button type="button" onclick="recollCalcClose()" style="font-size:26px;border:0;border-radius:8px;padding:2px 12px">‹</button><b style="font-size:21px;color:#123c91">'+title+'</b></div><div style="padding:16px">'+html+'</div>';
    overlay.style.display='block';window.scrollTo(0,0);
  }
  function close(){var o=document.getElementById('recollHubOverlay');if(o)o.style.display='none';}
  window.recollCalcClose=close;
  window.recollAbrirCalculadora=function(){
    panel('Calculadora de preços','<p style="color:#667085">Informe a quantidade e o preço unitário para calcular o total do serviço.</p><label style="display:block;margin:12px 0 5px">Serviço</label><input id="rcCalcService" placeholder="Ex.: Limpeza pós-obra" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"><div style="display:flex;gap:10px;margin-top:12px"><div style="flex:1"><label>Quantidade</label><input id="rcCalcQty" type="number" min="0" step="0.01" value="500" oninput="recollCalcTotal()" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"></div><div style="flex:1"><label>Preço unitário (R$)</label><input id="rcCalcPrice" type="number" min="0" step="0.01" value="8" oninput="recollCalcTotal()" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"></div></div><div style="background:#edf3ff;border-radius:12px;padding:16px;margin-top:16px"><div style="color:#123c91">Total estimado</div><strong id="rcCalcResult" style="font-size:28px;color:#123c91">R$ 4.000,00</strong></div><button type="button" onclick="recollCalcUseQuote()" style="width:100%;margin-top:14px;padding:14px;background:#1457d9;color:white;border:0;border-radius:10px;font-weight:bold;font-size:16px">Usar no orçamento</button>');
    window.recollCalcTotal();
  };
  window.recollCalcTotal=function(){var q=parseFloat(document.getElementById('rcCalcQty')?.value)||0,p=parseFloat(document.getElementById('rcCalcPrice')?.value)||0;var r=document.getElementById('rcCalcResult');if(r)r.textContent=(q*p).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});};
  window.recollCalcUseQuote=function(){var q=parseFloat(document.getElementById('rcCalcQty')?.value)||0,p=parseFloat(document.getElementById('rcCalcPrice')?.value)||0,name=(document.getElementById('rcCalcService')?.value||'').trim();close();if(typeof window.show==='function')window.show('new');var service=document.getElementById('service');if(service&&name){var opt=[...service.options].find(o=>o.text.toLowerCase().includes(name.toLowerCase())||o.value.toLowerCase().includes(name.toLowerCase()));if(opt)service.value=opt.value;if(typeof window.fields==='function')window.fields();}var qty=document.getElementById('qty'),base=document.getElementById('base');if(qty)qty.value=q;if(base)base.value=p;if(typeof window.calculate==='function'&&qty&&base)window.calculate();};
  window.recollAbrirAssistente=function(){
    panel('Assistente de orçamento','<p style="color:#667085">Responda aos campos para organizar o serviço e preparar uma estimativa. O resultado é uma orientação inicial, não substitui a vistoria.</p><label style="display:block;margin:12px 0 5px">Serviço a executar</label><input id="rcAsService" placeholder="Ex.: Limpeza pós-obra comercial" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"><div style="display:flex;gap:10px;margin-top:12px"><div style="flex:1"><label>Área (m²)</label><input id="rcAsArea" type="number" min="0" value="500" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"></div><div style="flex:1"><label>Preço por m² (R$)</label><input id="rcAsRate" type="number" min="0" step="0.01" value="8" style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"></div></div><label style="display:block;margin:12px 0 5px">Detalhes / itens extras</label><textarea id="rcAsNotes" rows="3" placeholder="Banheiros, janelas, escadas, garagem, nível de sujeira..." style="box-sizing:border-box;width:100%;padding:13px;border:1px solid #ccd3df;border-radius:10px;font-size:16px"></textarea><button type="button" onclick="recollAssistantEstimate()" style="width:100%;margin-top:14px;padding:14px;background:#159447;color:white;border:0;border-radius:10px;font-weight:bold;font-size:16px">Montar estimativa</button><div id="rcAsResult" style="margin-top:14px"></div>');
  };
  window.recollAssistantEstimate=function(){var s=(document.getElementById('rcAsService')?.value||'Serviço').trim(),a=parseFloat(document.getElementById('rcAsArea')?.value)||0,r=parseFloat(document.getElementById('rcAsRate')?.value)||0,n=(document.getElementById('rcAsNotes')?.value||'').trim(),total=a*r;var out=document.getElementById('rcAsResult');if(out)out.innerHTML='<div style="background:#edf7ef;border-radius:12px;padding:15px"><b style="font-size:18px">'+s.replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})+'</b><p>Área informada: '+a.toLocaleString('pt-BR')+' m²</p><p>Preço usado: '+r.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})+'/m²</p><b style="font-size:25px;color:#123c91">'+total.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})+'</b>'+(n?'<p><b>Detalhes:</b> '+n.replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})+'</p>':'')+'<p style="color:#667085;font-size:12px">Estimativa inicial. Confira mão de obra, materiais, deslocamento e margem antes de fechar.</p><button type="button" onclick="recollAssistantToCalculator()" style="padding:11px;background:#1457d9;color:#fff;border:0;border-radius:9px">Abrir na calculadora</button></div>';};
  window.recollAssistantToCalculator=function(){var s=document.getElementById('rcAsService')?.value||'',a=document.getElementById('rcAsArea')?.value||'0',r=document.getElementById('rcAsRate')?.value||'0';window.recollAbrirCalculadora();var x=document.getElementById('rcCalcService'),q=document.getElementById('rcCalcQty'),p=document.getElementById('rcCalcPrice');if(x)x.value=s;if(q)q.value=a;if(p)p.value=r;window.recollCalcTotal();};
})();

</script>
</body>
</html>
